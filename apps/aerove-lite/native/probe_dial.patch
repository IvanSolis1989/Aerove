-/// Connects to one of the candidate endpoints using Happy Eyeballs v2 (RFC
-/// 8305).
-///
-/// Addresses are sorted and interleaved (IPv6 first). The preferred address is
-/// dialed immediately. If the first attempt does not connect within
-/// [`HAPPY_EYEBALLS_DELAY`], subsequent candidates are dialed in parallel.
-/// Whichever TCP connection succeeds first is returned immediately,
-/// and the remaining in-flight attempts are aborted.
+static TCP_CONCURRENT: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(true);
+
+pub fn set_tcp_concurrent(value: bool) {
+    TCP_CONCURRENT.store(value, std::sync::atomic::Ordering::Release);
+}
+pub fn get_tcp_concurrent() -> bool {
+    TCP_CONCURRENT.load(std::sync::atomic::Ordering::Acquire)
+}
+
+/// Parallel mode races all addresses. Serial mode walks each family in resolver
+/// order, while keeping dual-stack fallback alive (Standard's default no-preference).
+/// Futures are owned here, never spawned: winner, timeout and cancellation drop losers.
+pub async fn aerove_dial_candidates<T, F, Fut>(
+    endpoints: &[SocketAddr], concurrent: bool, dial: F,
+) -> std::io::Result<T>
+where
+    T: Send,
+    F: Fn(SocketAddr) -> Fut + Sync,
+    Fut: std::future::Future<Output = std::io::Result<T>> + Send,
+{
+    use futures::FutureExt;
+    let groups = if concurrent {
+        endpoints.iter().map(|addr| vec![*addr]).collect::<Vec<_>>()
+    } else {
+        vec![endpoints.iter().copied().filter(SocketAddr::is_ipv6).collect(),
+             endpoints.iter().copied().filter(SocketAddr::is_ipv4).collect()]
+    };
+    let mut attempts = FuturesUnordered::new();
+    for group in groups.into_iter().filter(|group| !group.is_empty()) {
+        let dial = &dial;
+        attempts.push(async move {
+            let mut errors = Vec::new();
+            for addr in group {
+                match dial(addr).await {
+                    Ok(stream) => return Ok(stream),
+                    Err(error) => errors.push(format!("{addr}: {error}")),
+                }
+            }
+            Err(std::io::Error::other(errors.join("; ")))
+        }.boxed());
+    }
+    let mut errors = Vec::new();
+    while let Some(result) = attempts.next().await {
+        match result {
+            Ok(stream) => return Ok(stream),
+            Err(error) => errors.push(error.to_string()),
+        }
+    }
+    Err(std::io::Error::other(if errors.is_empty() {
+        "no destination address provided".to_owned()
+    } else { errors.join("; ") }))
+}
