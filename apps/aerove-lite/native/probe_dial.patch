+/// One connection owns both HEADs and the HTTP driver. Dropping this future closes it.
+pub async fn aerove_probe_head_exchange<S>(
+    stream: S, url: &str, unified: bool, start: tokio::time::Instant,
+    deadline: tokio::time::Instant,
+) -> std::io::Result<(Duration, Duration)>
+where S: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin + Send + 'static {
+    let uri: http::Uri = url.parse().map_err(std::io::Error::other)?;
+    let authority = uri.authority().ok_or_else(|| new_io_error("probe URL has no authority"))?;
+    let request = || Request::head(uri.path_and_query().map(|p| p.as_str()).unwrap_or("/"))
+        .header(hyper::header::HOST, authority.as_str())
+        .version(hyper::Version::HTTP_11)
+        .body(Empty::<Bytes>::new()).map_err(std::io::Error::other);
+    let (mut sender, connection) = tokio::time::timeout_at(
+        deadline, hyper::client::conn::http1::handshake(TokioIo::new(stream)),
+    ).await.map_err(|_| new_io_error("probe HTTP handshake timed out"))?
+        .map_err(std::io::Error::other)?;
+    let query = async {
+        let response = tokio::time::timeout_at(deadline, sender.send_request(request()?)).await
+            .map_err(|_| new_io_error("probe HEAD timed out"))?.map_err(std::io::Error::other)?;
+        drop(response);
+        let first = start.elapsed();
+        let selected = if unified {
+            let second = tokio::time::Instant::now();
+            match tokio::time::timeout_at(deadline, async {
+                sender.ready().await.map_err(std::io::Error::other)?;
+                sender.send_request(request()?).await.map_err(std::io::Error::other)
+            }).await {
+                Ok(Ok(response)) => { drop(response); second.elapsed() }
+                _ => first,
+            }
+        } else { first };
+        // Zero is the consumers' failure sentinel, including health-check history.
+        Ok((selected.max(Duration::from_millis(1)), start.elapsed().max(Duration::from_millis(1))))
+    };
+    tokio::pin!(query, connection);
+    tokio::select! {
+        result = &mut query => result,
+        _ = &mut connection => query.await,
+    }
+}
 
