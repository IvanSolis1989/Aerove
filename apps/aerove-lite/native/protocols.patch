+#[cfg(feature = "shadowquic")]
+fn deserialize_sq_congestion<'de,D:serde::Deserializer<'de>>(deserializer:D)->Result<Option<SQCongestionControl>,D::Error> {
+    use serde::Deserialize;
+    let value=Option::<serde_yaml::Value>::deserialize(deserializer)?;
+    value.map(|mut value| {
+        if value.as_str()==Some("new_reno") {value=serde_yaml::Value::String("new-reno".into());}
+        serde_yaml::from_value(value).map_err(serde::de::Error::custom)
+    }).transpose()
+}
