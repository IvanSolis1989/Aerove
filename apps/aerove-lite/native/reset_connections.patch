+    async fn reset_connections(&self) -> anyhow::Result<()> {
+        let mut inner = self.inner.write().await;
+        inner.c.take();
+        if let Some(background) = inner.bg_handle.take() {
+            background.abort();
+            if let Err(error) = background.await {
+                if !error.is_cancelled() { return Err(error.into()); }
+            }
+        }
+        Ok(())
+    }
