+    async fn reset_connections(&self) -> anyhow::Result<()> {
+        let mut clients = self.main.clone();
+        if let Some(fallback) = &self.fallback { clients.extend(fallback.iter().cloned()); }
+        if let Some(proxy) = &self.proxy_resolver { clients.extend(proxy.iter().cloned()); }
+        if let Some(policy) = &self.policy {
+            policy.traverse(|_, values| { clients.extend(values.iter().cloned()); true });
+        }
+        let mut seen = std::collections::HashSet::new();
+        for client in clients {
+            if seen.insert(Arc::as_ptr(&client) as *const () as usize) {
+                client.reset_connections().await?;
+            }
+        }
+        if let Some(default) = &self.default_resolver { default.reset_connections().await?; }
+        Ok(())
+    }
+
