+/// Resolve the typed config before either supplied-FD or device-created setup.
+pub(crate) fn mtu_for_config(cfg: &TunConfig) -> Result<usize, Error> {
+    let mtu = cfg.mtu.map(usize::from).unwrap_or(if cfg!(windows) { 65535 } else { watfaq_netstack::DEFAULT_MTU });
+    watfaq_netstack::validate_mtu(mtu).map_err(|_| Error::InvalidConfig("tun.mtu must be in 1280..65535".into()))
+}
+
+/// Mobile tun-rs defaults to a ~4KiB buffer; never truncate a larger L3 frame.
+pub(crate) fn framed_device(tun: tun_rs::AsyncDevice, mtu: usize) -> Result<
+    tun_rs::async_framed::DeviceFramed<tun_rs::async_framed::BytesCodec>, Error,
+> {
+    watfaq_netstack::validate_mtu(mtu)?;
+    let mut framed = tun_rs::async_framed::DeviceFramed::new(tun, tun_rs::async_framed::BytesCodec::new());
+    framed.set_read_buffer_size(framed.read_buffer_size().max(mtu));
+    framed.set_write_buffer_size(framed.write_buffer_size().max(mtu));
+    Ok(framed)
+}
