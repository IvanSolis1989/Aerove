+/// L3 MTU defaults retained for callers of the original constructors.
+pub const DEFAULT_MTU: usize = 1500;
+pub const MIN_MTU: usize = 1280;
+pub const MAX_MTU: usize = 65535;
+
+/// Validate before allocating channels, spawning tasks or consuming a device.
+pub fn validate_mtu(mtu: usize) -> std::io::Result<usize> {
+    if !(MIN_MTU..=MAX_MTU).contains(&mtu) {
+        return Err(std::io::Error::new(std::io::ErrorKind::InvalidInput,
+            "tun.mtu must be in 1280..65535"));
+    }
+    Ok(mtu)
+}
