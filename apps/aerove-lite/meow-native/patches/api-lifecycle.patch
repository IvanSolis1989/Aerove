+#[cfg(target_os = "android")]
+async fn read_rss_bytes() -> u64 {
+    let Ok(status) = tokio::fs::read_to_string("/proc/self/status").await else { return 0; };
+    status.lines().find_map(|line| {
+        let kb = line.strip_prefix("VmRSS:")?.split_whitespace().next()?.parse::<u64>().ok()?;
+        kb.checked_mul(1024)
+    }).unwrap_or(0)
+}
