+// SPDX-License-Identifier: GPL-3.0-only
+use meow_common::socket_protect::NetworkScope;
+use parking_lot::Mutex;
+use std::{collections::BTreeMap, future::Future, sync::{Arc, Weak}};
+use tokio::task::{AbortHandle, JoinHandle};
+use tokio_util::task::TaskTracker;
+
+tokio::task_local! { static CURRENT: Arc<OwnedIngress>; }
+struct Admission { closed: bool, next: u64, tasks: BTreeMap<u64, AbortHandle> }
+pub struct OwnedIngress { gate: Mutex<Admission>, tracker: TaskTracker }
+struct Registration { owner: Weak<OwnedIngress>, id: u64 }
+impl Drop for Registration {
+    fn drop(&mut self) { if let Some(owner) = self.owner.upgrade() { owner.gate.lock().tasks.remove(&self.id); } }
+}
+impl OwnedIngress {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self { gate: Mutex::new(Admission { closed: false, next: 1, tasks: BTreeMap::new() }), tracker: TaskTracker::new() })
+    }
+    pub fn current() -> Option<Arc<Self>> { CURRENT.try_with(Clone::clone).ok() }
+    pub async fn scope<F: Future>(self: &Arc<Self>, work: F) -> F::Output { CURRENT.scope(self.clone(), work).await }
+    pub fn spawn<F>(self: &Arc<Self>, work: F) -> JoinHandle<F::Output>
+    where F: Future + Send + 'static, F::Output: Send + 'static {
+        let mut gate = self.gate.lock();
+        if gate.closed {
+            drop(gate);
+            drop(work);
+            panic!("inbound owner closed");
+        }
+        let context = NetworkScope::current().expect("owned ingress requires captured network");
+        let id = gate.next; gate.next = id.checked_add(1).expect("inbound task identity exhausted");
+        let token = self.tracker.token();
+        let registration = Registration { owner: Arc::downgrade(self), id };
+        let owner = self.clone();
+        let task = tokio::spawn(async move {
+            let _registration = registration;
+            let _token = token;
+            owner.scope(context.scope(work)).await
+        });
+        gate.tasks.insert(id, task.abort_handle());
+        task
+    }
+    pub async fn close(&self) {
+        let tasks = {
+            let mut gate = self.gate.lock(); gate.closed = true; self.tracker.close();
+            gate.tasks.values().cloned().collect::<Vec<_>>()
+        };
+        for task in tasks { task.abort(); }
+        self.tracker.wait().await;
+    }
+}
