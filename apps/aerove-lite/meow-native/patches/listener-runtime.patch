+use parking_lot::Mutex;
+use std::{cell::RefCell, collections::HashMap, future::Future, pin::Pin, sync::{Arc, atomic::{AtomicU64, Ordering}}};
+use tokio::{sync::Notify, task::{AbortHandle, JoinHandle}};
+
+tokio::task_local! { static CURRENT: Arc<OwnedLoadScope>; }
+thread_local! { static BLOCKING: RefCell<Option<Arc<OwnedLoadScope>>> = const { RefCell::new(None) }; }
+
+#[derive(Default)]
+struct Jobs { closed: bool, panicked: bool, tasks: HashMap<u64, Option<AbortHandle>>, threads: Vec<std::thread::JoinHandle<()>> }
+
+pub type OwnedWork = Pin<Box<dyn Future<Output = ()> + Send + 'static>>;
+#[derive(Clone)]
+pub struct ProviderRoots {
+    pub resource_read_root: Option<std::path::PathBuf>,
+    pub cache_root: std::path::PathBuf,
+}
+pub trait LoadContext: Send + Sync {
+    fn requires_provider_roots(&self) -> bool { false }
+    fn provider_roots(&self) -> Option<ProviderRoots> { None }
+    fn provider_observer(&self) -> Option<Arc<dyn crate::provider_events::ProviderObserver>> { None }
+    fn requires_physical_dns(&self) -> bool { false }
+    fn physical_dns_servers(&self) -> Option<Vec<std::net::SocketAddr>> { None }
+    fn wrap(&self, work: OwnedWork) -> OwnedWork;
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>);
+}
+struct IdentityContext;
+impl LoadContext for IdentityContext {
+    fn wrap(&self, work: OwnedWork) -> OwnedWork { work }
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>) { work(); }
+}
+pub struct OwnedLoadScope {
+    jobs: Mutex<Jobs>, changed: Notify, serial: AtomicU64, context: Arc<dyn LoadContext>,
+}
+
+struct Lease { owner: Arc<OwnedLoadScope>, id: u64 }
+impl Drop for Lease {
+    fn drop(&mut self) {
+        let mut jobs = self.owner.jobs.lock();
+        jobs.panicked |= std::thread::panicking();
+        jobs.tasks.remove(&self.id);
+        drop(jobs);
+        self.owner.changed.notify_waiters();
+    }
+}
+
+impl OwnedLoadScope {
+    pub fn new() -> Arc<Self> { Self::with_context(Arc::new(IdentityContext)) }
+    pub fn with_context(context: Arc<dyn LoadContext>) -> Arc<Self> {
+        Arc::new(Self { jobs: Mutex::new(Jobs::default()), changed: Notify::new(),
+            serial: AtomicU64::new(0), context })
+    }
+    pub fn current() -> Option<Arc<Self>> {
+        CURRENT.try_with(Arc::clone).ok().or_else(|| BLOCKING.with(|slot| slot.borrow().clone()))
+    }
+    pub fn provider_observer(&self) -> Option<Arc<dyn crate::provider_events::ProviderObserver>> { self.context.provider_observer() }
+    pub fn provider_roots(&self) -> Result<Option<ProviderRoots>, &'static str> {
+        let Some(roots) = self.context.provider_roots() else {
+            return if self.context.requires_provider_roots() { Err("providerRootsMissing") } else { Ok(None) };
+        };
+        if !roots.cache_root.is_absolute() || roots.resource_read_root.as_ref().is_some_and(|path| !path.is_absolute()) {
+            return Err("providerRootsInvalid");
+        }
+        let cache_root = roots.cache_root.canonicalize().map_err(|_| "providerCacheRootInvalid")?;
+        let resource_read_root = roots.resource_read_root.as_ref().map(|path| path.canonicalize().map_err(|_| "providerReadRootInvalid")).transpose()?;
+        if resource_read_root.as_ref().is_some_and(|read| cache_root.starts_with(read) || read.starts_with(&cache_root)) {
+            return Err("providerRootsOverlap");
+        }
+        if !cache_root.is_dir() || resource_read_root.as_ref().is_some_and(|read| !read.is_dir()) {
+            return Err("providerRootsInvalid");
+        }
+        Ok(Some(roots))
+    }
+    pub fn disabled_dns_servers(&self) -> Result<Option<Vec<std::net::SocketAddr>>, &'static str> {
+        let Some(servers) = self.context.physical_dns_servers() else {
+            return if self.context.requires_physical_dns() { Err("physicalDnsSnapshotMissing") } else { Ok(None) };
+        };
+        if servers.is_empty() { return Err("physicalDnsSnapshotEmpty"); }
+        if servers.iter().any(|server| server.port() == 0 || server.ip().is_unspecified() || server.ip().is_multicast()) {
