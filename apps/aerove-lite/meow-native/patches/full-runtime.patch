+/// The matcher builders emit accepted entries once into bounded buffered storage.
+/// The offset index lives on disk, avoiding a permanent second Vec<String> for MRS.
+pub struct PageCapture {
+    state: Mutex<CaptureState>,
+}
+struct CaptureState {
+    data: Option<BufWriter<File>>,
+    index: Option<BufWriter<File>>,
+    paths: Option<[PathBuf; 2]>,
+    count: usize,
+    bytes: u64,
+    error: Option<String>,
+}
+pub struct RulePages {
+    files: Mutex<Option<(File, File)>>,
+    paths: [PathBuf; 2],
+    count: usize,
+}
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
