+    fn provider_roots(&self) -> Option<ProviderRoots> {
+        Some(self.roots.clone())
+    }
+    fn provider_observer(&self) -> Option<Arc<dyn ProviderObserver>> {
+        Some(Arc::new(Observer(self.epoch.clone())))
+    }
+    fn wrap(&self, work: OwnedWork) -> OwnedWork {
+        work
+    }
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>) {
+        work();
+    }
+}
