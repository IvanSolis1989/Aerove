+        poll_fn(|cx| { assert!(first.as_mut().poll(cx).is_pending()); Poll::Ready(()) }).await;
+        drop(first);
+        let mut retry = Box::pin(scope.close());
+        poll_fn(|cx| { assert!(retry.as_mut().poll(cx).is_pending()); Poll::Ready(()) }).await;
+        release.send(()).unwrap();
+        retry.await.unwrap();
+    }
+}
