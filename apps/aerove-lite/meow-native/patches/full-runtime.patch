+pub(crate) fn spawn<F>(work: F) -> JoinHandle<F::Output>
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    let Some(owner) = OwnedLoadScope::current() else { return tokio::spawn(work); };
+    let Some(lease) = owner.lease() else {
+        return tokio::spawn(async { panic!("ownedLoadScopeClosed") });
+    };
+    let id = lease.id;
+    let wrapped = wrap_with(owner.clone(), work);
+    let task = tokio::spawn(async move { let _lease = lease; wrapped.await });
+    let mut jobs = owner.jobs.lock();
+    if jobs.closed { task.abort(); }
+    if let Some(slot) = jobs.tasks.get_mut(&id) { *slot = Some(task.abort_handle()); }
+    task
+}
+
+fn blocking_with<F, R>(owner: Arc<OwnedLoadScope>, work: F) -> R
+where F: FnOnce() -> R + Send + 'static, R: Send + 'static {
+    let result = Arc::new(Mutex::new(None));
+    let output = result.clone();
+    let context = owner.context.clone();
+    context.run_blocking(Box::new(move || {
+        BLOCKING.with(|slot| {
+            let prior = slot.replace(Some(owner));
+            struct Restore<'a>(&'a RefCell<Option<Arc<OwnedLoadScope>>>, Option<Arc<OwnedLoadScope>>);
+            impl Drop for Restore<'_> { fn drop(&mut self) { self.0.replace(self.1.take()); } }
+            let _restore = Restore(slot, prior);
+            *output.lock() = Some(work());
+        })
+    }));
+    let value = result.lock().take().expect("LoadContext must run blocking work");
+    value
+}
+
+pub(crate) fn wrap_with<F>(owner: Arc<OwnedLoadScope>, work: F) -> impl Future<Output = F::Output> + Send
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    let result = Arc::new(Mutex::new(None));
+    let output = result.clone();
+    let context = owner.context.clone();
+    let wrapped = context.wrap(Box::pin(async move {
+        let value = owner.run(work).await;
+        *output.lock() = Some(value);
+    }));
+    async move {
+        wrapped.await;
+        let value = result.lock().take().expect("LoadContext must await async work");
+        value
+    }
+}
+
+pub(crate) fn wrap_current<F>(work: F) -> impl Future<Output = F::Output> + Send
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    let owner = OwnedLoadScope::current();
+    async move {
+        match owner { Some(owner) => wrap_with(owner, work).await, None => work.await }
+    }
+}
+
+pub(crate) fn spawn_blocking<F, R>(work: F) -> JoinHandle<R>
+where F: FnOnce() -> R + Send + 'static, R: Send + 'static {
+    let Some(owner) = OwnedLoadScope::current() else { return tokio::task::spawn_blocking(work); };
+    let Some(lease) = owner.lease() else {
+        return tokio::spawn(async { panic!("ownedLoadScopeClosed") });
+    };
+    tokio::task::spawn_blocking(move || {
+        let _lease = lease;
+        blocking_with(owner, work)
+    })
+}
+
+pub(crate) fn spawn_thread<F>(builder: std::thread::Builder, work: F) -> std::io::Result<()>
+where F: FnOnce() + Send + 'static {
+    let owner = OwnedLoadScope::current();
+    let lease = match owner.as_ref() {
+        Some(owner) => Some(owner.lease().ok_or_else(|| std::io::Error::new(std::io::ErrorKind::Interrupted, "ownedLoadScopeClosed"))?),
+        None => None,
+    };
+    let mut jobs = owner.as_ref().map(|owner| owner.jobs.lock());
+    let context = owner.clone();
+    let thread = builder.spawn(move || {
+        let _lease = lease;
+        match context { Some(owner) => blocking_with(owner, work), None => work() }
+    })?;
+    if let Some(jobs) = jobs.as_mut() { jobs.threads.push(thread); }
+    Ok(())
+}
