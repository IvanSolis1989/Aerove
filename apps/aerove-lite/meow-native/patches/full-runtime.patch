+        let result = dial_candidates(&addresses(), true, |address| {
+            let active = active.clone(); let entered = entered.clone();
+            async move {
+                active.fetch_add(1, Ordering::SeqCst); entered.fetch_add(1, Ordering::SeqCst);
+                let _guard = Active(active);
