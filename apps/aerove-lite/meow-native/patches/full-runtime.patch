+impl ProviderObserver for Observer {
+    fn validate(&self, _kind: ProviderKind, _name: &str) -> Result<(), String> {
+        Ok(())
+    }
+    fn begin(&self, _identity: &ProviderIdentity) -> Result<Arc<dyn ProviderLease>, String> {
+        Ok(Arc::new(Lease {
+            epoch: self.0.load(Ordering::Acquire),
+            current: self.0.clone(),
+        }))
+    }
+}
+struct Context {
