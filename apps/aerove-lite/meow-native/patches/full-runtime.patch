+fn reader15_prefetch_retains_open_descriptor_across_path_replacement_and_repeated_parse() {
+    let directory = tempfile::tempdir().unwrap();
+    let path = directory.path().join("rules.mrs");
+    std::fs::write(&path, DOMAIN).unwrap();
+    let source = Source::open(&path).unwrap();
+    assert!(source.as_bytes().is_none());
