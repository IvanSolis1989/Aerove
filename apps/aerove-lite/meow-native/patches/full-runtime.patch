+use parking_lot::Mutex;
+use std::{cell::RefCell, collections::HashMap, future::Future, pin::Pin, sync::{Arc, atomic::{AtomicU64, Ordering}}};
+use tokio::{sync::Notify, task::{AbortHandle, JoinHandle}};
+
+tokio::task_local! { static CURRENT: Arc<OwnedLoadScope>; }
+tokio::task_local! { static DNS_TRANSPORT: meow_common::transport_tasks::TransportScope; }
+thread_local! { static BLOCKING: RefCell<Option<Arc<OwnedLoadScope>>> = const { RefCell::new(None) }; }
+
+#[derive(Default)]
+struct Jobs { closed: bool, panicked: bool, tasks: HashMap<u64, Option<AbortHandle>>, threads: Vec<std::thread::JoinHandle<()>> }
+
+pub type OwnedWork = Pin<Box<dyn Future<Output = ()> + Send + 'static>>;
+#[derive(Clone)]
+pub struct ProviderRoots {
+    pub resource_read_root: Option<std::path::PathBuf>,
+    pub cache_root: std::path::PathBuf,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DisabledDnsSource {
+    Physical(Vec<std::net::SocketAddr>),
+    UnavailableNotConnected,
+}
+
+pub trait LoadContext: Send + Sync {
+    fn disabled_dns_source(&self) -> Result<DisabledDnsSource, &'static str> {
+        let Some(servers) = self.physical_dns_servers() else {
+            return Err(if self.requires_physical_dns() { "physicalDnsSnapshotMissing" } else { "disabledDnsSourceMissing" });
+        };
+        validate_disabled_dns_servers(servers).map(DisabledDnsSource::Physical)
+    }
+    fn requires_dns_transport_scope(&self) -> bool { false }
+    fn dns_transport_scope(&self) -> Option<meow_common::transport_tasks::TransportScope> { None }
+    fn offline_validation(&self) -> bool { false }
+    fn requires_provider_roots(&self) -> bool { false }
+    fn provider_roots(&self) -> Option<ProviderRoots> { None }
+    fn provider_observer(&self) -> Option<Arc<dyn crate::provider_events::ProviderObserver>> { None }
+    fn requires_physical_dns(&self) -> bool { false }
+    fn physical_dns_servers(&self) -> Option<Vec<std::net::SocketAddr>> { None }
+    fn wrap(&self, work: OwnedWork) -> OwnedWork;
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>);
+}
+struct IdentityContext;
+impl LoadContext for IdentityContext {
+    fn wrap(&self, work: OwnedWork) -> OwnedWork { work }
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>) { work(); }
+}
+pub struct OwnedLoadScope {
+    jobs: Mutex<Jobs>, changed: Notify, serial: AtomicU64, context: Arc<dyn LoadContext>,
+}
+
+fn validate_disabled_dns_servers(servers: Vec<std::net::SocketAddr>) -> Result<Vec<std::net::SocketAddr>, &'static str> {
+    if servers.is_empty() { return Err("physicalDnsSnapshotEmpty"); }
+    if servers.iter().any(|server| server.port() == 0 || server.ip().is_unspecified() || server.ip().is_multicast()) {
+        return Err("physicalDnsSnapshotInvalid");
+    }
+    Ok(servers)
+}
+
+struct Lease { owner: Arc<OwnedLoadScope>, id: u64 }
+impl Drop for Lease {
+    fn drop(&mut self) {
+        let mut jobs = self.owner.jobs.lock();
+        jobs.panicked |= std::thread::panicking();
+        jobs.tasks.remove(&self.id);
+        drop(jobs);
+        self.owner.changed.notify_waiters();
+    }
+}
+
+impl OwnedLoadScope {
+    pub fn new() -> Arc<Self> { Self::with_context(Arc::new(IdentityContext)) }
+    pub fn with_context(context: Arc<dyn LoadContext>) -> Arc<Self> {
+        Arc::new(Self { jobs: Mutex::new(Jobs::default()), changed: Notify::new(),
+            serial: AtomicU64::new(0), context })
+    }
+    pub fn current() -> Option<Arc<Self>> {
+        CURRENT.try_with(Arc::clone).ok().or_else(|| BLOCKING.with(|slot| slot.borrow().clone()))
+    }
+    pub fn offline_validation(&self) -> bool { self.context.offline_validation() }
+    pub fn provider_observer(&self) -> Option<Arc<dyn crate::provider_events::ProviderObserver>> { self.context.provider_observer() }
+    pub fn provider_roots(&self) -> Result<Option<ProviderRoots>, &'static str> {
+        let Some(roots) = self.context.provider_roots() else {
+            return if self.context.requires_provider_roots() { Err("providerRootsMissing") } else { Ok(None) };
+        };
+        if !roots.cache_root.is_absolute() || roots.resource_read_root.as_ref().is_some_and(|path| !path.is_absolute()) {
+            return Err("providerRootsInvalid");
+        }
+        let cache_root = roots.cache_root.canonicalize().map_err(|_| "providerCacheRootInvalid")?;
+        let resource_read_root = roots.resource_read_root.as_ref().map(|path| path.canonicalize().map_err(|_| "providerReadRootInvalid")).transpose()?;
+        if resource_read_root.as_ref().is_some_and(|read| cache_root.starts_with(read) || read.starts_with(&cache_root)) {
+            return Err("providerRootsOverlap");
+        }
+        if !cache_root.is_dir() || resource_read_root.as_ref().is_some_and(|read| !read.is_dir()) {
+            return Err("providerRootsInvalid");
+        }
+        Ok(Some(roots))
+    }
+    pub fn requires_physical_dns(&self) -> bool { self.context.requires_physical_dns() }
+    pub fn disabled_dns_source(&self) -> Result<DisabledDnsSource, &'static str> {
+        match self.context.disabled_dns_source()? {
+            DisabledDnsSource::UnavailableNotConnected => Ok(DisabledDnsSource::UnavailableNotConnected),
+            DisabledDnsSource::Physical(servers) => validate_disabled_dns_servers(servers).map(DisabledDnsSource::Physical),
+        }
+    }
+    pub fn disabled_dns_servers(&self) -> Result<Option<Vec<std::net::SocketAddr>>, &'static str> {
+        let Some(servers) = self.context.physical_dns_servers() else {
+            return if self.context.requires_physical_dns() { Err("physicalDnsSnapshotMissing") } else { Ok(None) };
+        };
+        if servers.is_empty() { return Err("physicalDnsSnapshotEmpty"); }
+        if servers.iter().any(|server| server.port() == 0 || server.ip().is_unspecified() || server.ip().is_multicast()) {
+            return Err("physicalDnsSnapshotInvalid");
+        }
+        Ok(Some(servers))
+    }
+    pub fn is_cancelled(&self) -> bool { self.jobs.lock().closed }
+    pub async fn cancelled(&self) {
+        loop {
+            let changed = self.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            if self.is_cancelled() { return; }
+            changed.await;
+        }
+    }
+    pub async fn run<F: Future>(self: &Arc<Self>, work: F) -> F::Output {
+        CURRENT.scope(self.clone(), work).await
+    }
+    /// Run caller-owned work in this session's captured context. A lease makes
+    /// close wait for the caller to drop its future; no background task escapes.
+    pub async fn run_captured<F>(self: &Arc<Self>, work: F) -> Result<F::Output, &'static str>
+    where F: Future + Send + 'static, F::Output: Send + 'static {
+        let _lease = self.lease().ok_or("ownedLoadScopeClosed")?;
+        let wrapped = wrap_with(self.clone(), work);
+        tokio::select! { biased;
+            _ = self.cancelled() => Err("ownedLoadScopeClosed"),
+            value = wrapped => Ok(value),
+        }
+    }
+    fn lease(self: &Arc<Self>) -> Option<Lease> {
+        let id = self.serial.fetch_add(1, Ordering::Relaxed);
+        let mut jobs = self.jobs.lock();
+        if jobs.closed { return None; }
+        jobs.tasks.insert(id, None);
+        Some(Lease { owner: self.clone(), id })
+    }
+    pub fn spawn_owned<F>(self: &Arc<Self>, work: F) -> Result<JoinHandle<F::Output>, &'static str>
+    where F: Future + Send + 'static, F::Output: Send + 'static {
+        let Some(lease) = self.lease() else { return Err("ownedLoadScopeClosed"); };
+        let id = lease.id;
+        let wrapped = wrap_with(self.clone(), work);
+        let task = tokio::spawn(async move { let _lease = lease; wrapped.await });
+        let mut jobs = self.jobs.lock();
+        if jobs.closed { task.abort(); }
+        if let Some(slot) = jobs.tasks.get_mut(&id) { *slot = Some(task.abort_handle()); }
+        Ok(task)
+    }
+    pub fn spawn_blocking_owned<F, R>(self: &Arc<Self>, work: F) -> Result<JoinHandle<R>, &'static str>
+    where F: FnOnce() -> R + Send + 'static, R: Send + 'static {
+        let lease = self.lease().ok_or("ownedLoadScopeClosed")?;
+        let owner = self.clone();
+        let diagnostic = meow_common::probe_policy::DiagnosticToken::capture();
+        Ok(tokio::task::spawn_blocking(move || {
+            let _lease = lease;
+            diagnostic.run(|| blocking_with(owner, work))
+        }))
+    }
+    pub fn cancel(&self) {
+        let mut jobs = self.jobs.lock();
+        jobs.closed = true;
+        let aborts: Vec<_> = jobs.tasks.values().flatten().cloned().collect();
+        drop(jobs);
+        for abort in aborts { abort.abort(); }
+        self.changed.notify_waiters();
+    }
+    pub async fn close(&self) -> Result<(), &'static str> {
+        self.cancel();
+        loop {
+            let changed = self.changed.notified();
+            tokio::pin!(changed);
+            changed.as_mut().enable();
+            let finished = self.jobs.lock().tasks.is_empty();
+            if finished { break; }
+            changed.await;
+        }
+        let mut jobs = self.jobs.lock();
+        let mut failed = jobs.panicked;
+        for thread in jobs.threads.drain(..) { failed |= thread.join().is_err(); }
+        if failed { Err("providerThreadPanicked") } else { Ok(()) }
+    }
+}
+
+pub(crate) fn spawn<F>(work: F) -> JoinHandle<F::Output>
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    let Some(owner) = OwnedLoadScope::current() else { return tokio::spawn(meow_common::probe_policy::DiagnosticToken::capture().scope(work)); };
+    owner.spawn_owned(work).unwrap_or_else(|_| tokio::spawn(async { panic!("ownedLoadScopeClosed") }))
+}
+
+fn blocking_with<F, R>(owner: Arc<OwnedLoadScope>, work: F) -> R
+where F: FnOnce() -> R + Send + 'static, R: Send + 'static {
+    let diagnostic = meow_common::probe_policy::DiagnosticToken::capture();
+    let result = Arc::new(Mutex::new(None));
+    let output = result.clone();
+    let context = owner.context.clone();
+    context.run_blocking(Box::new(move || {
+        diagnostic.run(|| BLOCKING.with(|slot| {
+            let prior = slot.replace(Some(owner));
+            struct Restore<'a>(&'a RefCell<Option<Arc<OwnedLoadScope>>>, Option<Arc<OwnedLoadScope>>);
+            impl Drop for Restore<'_> { fn drop(&mut self) { self.0.replace(self.1.take()); } }
+            let _restore = Restore(slot, prior);
+            *output.lock() = Some(work());
+        }))
+    }));
+    let value = result.lock().take().expect("LoadContext must run blocking work");
+    value
+}
+
+pub(crate) fn wrap_with<F>(owner: Arc<OwnedLoadScope>, work: F) -> impl Future<Output = F::Output> + Send
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    let diagnostic = meow_common::probe_policy::DiagnosticToken::capture();
+    let result = Arc::new(Mutex::new(None));
+    let output = result.clone();
+    let context = owner.context.clone();
+    let wrapped = context.wrap(Box::pin(async move {
+        let value = owner.run(work).await;
+        *output.lock() = Some(value);
+    }));
+    diagnostic.scope(async move {
+        wrapped.await;
+        let value = result.lock().take().expect("LoadContext must await async work");
+        value
+    })
+}
+
+pub(crate) fn wrap_current<F>(work: F) -> impl Future<Output = F::Output> + Send
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    let owner = OwnedLoadScope::current();
+    meow_common::probe_policy::DiagnosticToken::capture().scope(async move {
+        match owner { Some(owner) => wrap_with(owner, work).await, None => work.await }
+    })
+}
+
+pub(crate) fn spawn_blocking<F, R>(work: F) -> JoinHandle<R>
+where F: FnOnce() -> R + Send + 'static, R: Send + 'static {
+    let diagnostic = meow_common::probe_policy::DiagnosticToken::capture();
+    let Some(owner) = OwnedLoadScope::current() else { return tokio::task::spawn_blocking(move || diagnostic.run(work)); };
+    let Some(lease) = owner.lease() else {
+        return tokio::spawn(async { panic!("ownedLoadScopeClosed") });
+    };
+    tokio::task::spawn_blocking(move || {
+        let _lease = lease;
+        diagnostic.run(|| blocking_with(owner, work))
+    })
+}
+
+pub(crate) fn spawn_thread<F>(builder: std::thread::Builder, work: F) -> std::io::Result<()>
+where F: FnOnce() + Send + 'static {
+    let diagnostic = meow_common::probe_policy::DiagnosticToken::capture();
+    let owner = OwnedLoadScope::current();
+    let lease = match owner.as_ref() {
+        Some(owner) => Some(owner.lease().ok_or_else(|| std::io::Error::new(std::io::ErrorKind::Interrupted, "ownedLoadScopeClosed"))?),
+        None => None,
+    };
+    let mut jobs = owner.as_ref().map(|owner| owner.jobs.lock());
+    let context = owner.clone();
+    let thread = builder.spawn(move || {
+        let _lease = lease;
+        diagnostic.run(|| match context { Some(owner) => blocking_with(owner, work), None => work() })
+    })?;
+    if let Some(jobs) = jobs.as_mut() { jobs.threads.push(thread); }
+    Ok(())
+}
