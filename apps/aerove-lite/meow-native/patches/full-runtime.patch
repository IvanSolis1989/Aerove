+//! Session-owned live observations. No task, timer, history scan or global sender.
+use parking_lot::Mutex;
+pub use serde_json;
+use serde_json::{json, Value};
+use std::{collections::VecDeque, future::Future, io, sync::Arc};
+use tokio::sync::broadcast;
+
+const MAX_FRAME: usize = 65_536;
+const MAX_EVENTS: usize = 32;
+const CAPACITY: usize = 128;
+
+#[derive(Clone)]
+struct Event { cursor: u64, value: Option<Arc<str>> }
+struct PendingTraffic { id:Arc<str>, upload:u64, download:u64 }
+struct State { cursor: u64, generation: u64, request: u64, stopped: bool, traffic:VecDeque<PendingTraffic> }
+/// One hub per runtime session, shared by statistics and every resolver generation.
+pub struct ObservationFeed {
+    session_id: String,
+    state: Mutex<State>,
+    sender: broadcast::Sender<Event>,
+    #[cfg(test)]
+    event_encodes: std::sync::atomic::AtomicUsize,
+}
+impl ObservationFeed {
+    pub fn new(session_id: String) -> Arc<Self> {
+        let (sender, _) = broadcast::channel(CAPACITY);
+        Arc::new(Self { session_id, state: Mutex::new(State { cursor: 0, generation: 0, request: 0, stopped: false, traffic:VecDeque::new() }), sender,
+            #[cfg(test)]
+            event_encodes: std::sync::atomic::AtomicUsize::new(0),
+        })
+    }
+    /// Subscription and watermark are captured under the producer's same lock.
+    pub fn activate(self: &Arc<Self>) -> io::Result<ObservationDelivery> {
+        let mut state = self.state.lock();
+        if state.stopped { return Err(io::Error::new(io::ErrorKind::Interrupted, "observation session stopped")); }
+        if self.sender.receiver_count()==0 { state.traffic.clear(); }
+        state.generation = state.generation.checked_add(1).ok_or_else(exhausted)?;
+        let receiver = self.sender.subscribe();
+        Ok(ObservationDelivery { feed: Arc::clone(self), receiver, generation: state.generation,
+            activation_cursor: state.cursor, cursor: state.cursor, dropped: 0, pending: VecDeque::new() })
+    }
+    /// Serialization is lazy: inactive pages do no observation JSON work.
+    /// Cursor advances even while inactive so a new lease never backfills old events.
+    pub fn publish(&self, kind: &'static str, data: impl FnOnce() -> Value) {
+        let mut state = self.state.lock();
+        self.publish_locked(&mut state,kind,data);
+    }
+    fn publish_locked(&self,state:&mut State,kind:&'static str,data:impl FnOnce()->Value) {
+        if state.stopped { return; }
+        let Some(cursor) = state.cursor.checked_add(1) else { state.stopped = true; let _ = self.sender.send(Event { cursor: state.cursor, value: None }); return };
+        state.cursor = cursor;
+        if self.sender.receiver_count() == 0 { return; }
+        let value = json!({"cursor": cursor.to_string(), "kind": kind, "data": data()});
+        // Oversize input becomes an explicit gap, never truncation or invalid JSON.
+        let value = self.encode_event(value);
+        let value = (value.len() <= MAX_FRAME - 1024).then_some(value);
+        let _ = self.sender.send(Event { cursor, value });
+    }
+    fn encode_event(&self, value: Value) -> Arc<str> {
+        #[cfg(test)]
+        self.event_encodes.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        Arc::from(value.to_string())
+    }
+    /// Dirty traffic snapshots, coalesced to Standard's one-second cadence.
+    /// This is a bounded delivery queue, not another connection registry:
+    /// no metadata, routes, owners, sockets, lookup service or lifetime state.
+    pub fn record_traffic(&self,id:Arc<str>,upload:u64,download:u64) {
+        self.record_traffic_with(id,||Some((upload,download)));
+    }
+    /// Read current owner counters and recheck admission under the same gate
+    /// that flushes traffic and publishes Closed. The closure never awaits.
+    pub fn record_traffic_with(&self,id:Arc<str>,snapshot:impl FnOnce()->Option<(u64,u64)>) {
+        let mut state=self.state.lock();
+        if state.stopped { return; }
+        if self.sender.receiver_count()==0 { state.traffic.clear();return; }
+        let Some((upload,download))=snapshot() else { return; };
+        if let Some(pending)=state.traffic.iter_mut().find(|pending|pending.id==id) {
+            pending.upload=pending.upload.max(upload);pending.download=pending.download.max(download);return;
+        }
+        if state.traffic.len()==CAPACITY {
+            state.traffic.pop_front();
+            if let Some(cursor)=state.cursor.checked_add(1) {
+                state.cursor=cursor;let _=self.sender.send(Event { cursor,value:None });
+            } else { state.stopped=true;let _=self.sender.send(Event { cursor:state.cursor,value:None });return; }
+        }
+        state.traffic.push_back(PendingTraffic { id,upload,download });
+    }
+    /// Called only by the existing official traffic feed's owned sampler.
+    pub fn flush_traffic(&self) {
+        let mut state=self.state.lock();
+        while let Some(traffic)=state.traffic.pop_front() {
+            self.publish_locked(&mut state,"requestTraffic",||json!({"id":traffic.id,"upload":traffic.upload.to_string(),"download":traffic.download.to_string()}));
+        }
+    }
+    pub fn flush_request_traffic(&self,id:&str) {
+        let mut state=self.state.lock();
+        self.flush_request_traffic_locked(&mut state,id);
+    }
+    fn flush_request_traffic_locked(&self,state:&mut State,id:&str) {
+        if let Some(index)=state.traffic.iter().position(|traffic|traffic.id.as_ref()==id) {
+            if let Some(traffic)=state.traffic.remove(index) {
+                self.publish_locked(state,"requestTraffic",||json!({"id":traffic.id,"upload":traffic.upload.to_string(),"download":traffic.download.to_string()}));
+            }
+        }
+    }
+    /// The owner closes admission before calling this; a concurrent snapshot
+    /// either enters before this gate and is flushed, or observes closed and
+    /// never queues after the terminal event. No extra identity registry.
+    pub fn close_request(&self,id:&str,data:impl FnOnce()->Value) {
+        let mut state=self.state.lock();
+        self.flush_request_traffic_locked(&mut state,id);
+        self.publish_locked(&mut state,"requestClosed",data);
+    }
+    /// Runtime stop wakes an awaiting delivery. No detached worker needs joining.
+    pub fn stop(&self) {
+        let mut state = self.state.lock();
+        state.stopped = true;
+        state.traffic.clear();
+        let _ = self.sender.send(Event { cursor: state.cursor, value: None });
+    }
+    pub fn is_active(&self) -> bool { self.sender.receiver_count() != 0 }
+}
+fn exhausted() -> io::Error { io::Error::other("observation sequence exhausted") }
+
+pub struct ObservationDelivery {
+    feed: Arc<ObservationFeed>, receiver: broadcast::Receiver<Event>, generation: u64,
+    activation_cursor: u64, cursor: u64, dropped: u64, pending: VecDeque<Event>,
+}
+impl ObservationDelivery {
+    fn empty_frame(&self) -> String {
+        json!({"type":"observations", "sessionId":self.feed.session_id, "generation":self.generation.to_string(),
+            "cursor":self.cursor.to_string(), "activationCursor":self.activation_cursor.to_string(),
+            "dropped":self.dropped.to_string(), "events":[]}).to_string()
+    }
+    fn frame(&self, events: &[Arc<str>]) -> String {
+        let mut frame = self.empty_frame();
+        let insertion = frame.find("\"events\":[]").expect("fixed observation envelope") + "\"events\":[".len();
+        let suffix = frame.split_off(insertion);
+        frame.reserve(events.iter().map(|event| event.len()).sum::<usize>() + events.len().saturating_sub(1) + suffix.len());
+        for (index, event) in events.iter().enumerate() {
+            if index != 0 { frame.push(','); }
+            frame.push_str(event);
+        }
+        frame.push_str(&suffix);
+        frame
+    }
+    /// Stable empty activation ACK; producers after activate cannot enter this frame.
+    pub fn activation_frame(&self) -> String {
+        json!({"type":"observations", "sessionId":self.feed.session_id, "generation":self.generation.to_string(),
+            "cursor":self.activation_cursor.to_string(), "activationCursor":self.activation_cursor.to_string(),
+            "dropped":"0", "events":[]}).to_string()
+    }
+    pub async fn next_frame(&mut self) -> io::Result<String> {
+        let first = if let Some(event) = self.pending.pop_front() { event } else {
+            loop {
+                if self.feed.state.lock().stopped { return Err(io::Error::new(io::ErrorKind::Interrupted, "observation session stopped")); }
+                match self.receiver.recv().await {
+                    Ok(event) => break event,
+                    Err(broadcast::error::RecvError::Lagged(_)) => continue, // exact loss follows from cursor difference
+                    Err(broadcast::error::RecvError::Closed) => return Err(io::Error::new(io::ErrorKind::Interrupted, "observation feed closed")),
+                }
+            }
+        };
+        self.pending.push_front(first);
+        let mut events = Vec::new();
+        let mut event_bytes = 0;
+        loop {
+            let event = if let Some(event) = self.pending.pop_front() { event } else {
+                match self.receiver.try_recv() {
+                    Ok(event) => event,
+                    Err(broadcast::error::TryRecvError::Lagged(_)) => continue,
+                    Err(_) => break,
+                }
+            };
+            if event.cursor <= self.cursor { continue; }
+            let old_cursor = self.cursor;
+            let old_dropped = self.dropped;
+            self.dropped = self.dropped.checked_add(event.cursor - old_cursor - 1).ok_or_else(exhausted)?;
+            self.cursor = event.cursor;
+            if let Some(value) = event.value.as_ref() {
+                event_bytes += value.len() + usize::from(!events.is_empty());
+                events.push(Arc::clone(value));
+            }
+            else { self.dropped = self.dropped.checked_add(1).ok_or_else(exhausted)?; }
+            if self.empty_frame().len() + event_bytes > MAX_FRAME {
+                if event.value.is_some() { events.pop(); }
+                self.cursor = old_cursor; self.dropped = old_dropped;
+                self.pending.push_front(event); break;
+            }
+            if events.len() == MAX_EVENTS { break; }
+        }
+        if self.feed.state.lock().stopped { return Err(io::Error::new(io::ErrorKind::Interrupted, "observation session stopped")); }
+        Ok(self.frame(&events))
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+pub enum DnsInitiator { App, Rule, Direct, Proxy, #[default] Other }
+impl DnsInitiator {
+    pub fn as_str(self) -> &'static str { match self { Self::App=>"App",Self::Rule=>"Rule",Self::Direct=>"Direct",Self::Proxy=>"Proxy",Self::Other=>"Other" } }
+}
+tokio::task_local! { static DNS_INITIATOR: DnsInitiator; }
+impl DnsInitiator {
+    pub fn current() -> Self { DNS_INITIATOR.try_with(|value| *value).unwrap_or_default() }
+    pub fn in_scope<T>(self, work: impl FnOnce() -> T) -> T { DNS_INITIATOR.sync_scope(self, work) }
+    /// Only logical resolver entry/return is scoped. Upstream child tasks never publish.
+    pub async fn scope<F: Future>(self, work: F) -> F::Output { DNS_INITIATOR.scope(self, work).await }
+}
+/// RFC3339 timestamp shared by producers without a new dependency.
+pub fn timestamp() -> String {
+    timestamp_at(std::time::SystemTime::now())
+}
+pub fn timestamp_at(value: std::time::SystemTime) -> String {
+    time::OffsetDateTime::from(value).format(&time::format_description::well_known::Rfc3339)
+        .unwrap_or_else(|_| "1970-01-01T00:00:00Z".to_owned())
+}
