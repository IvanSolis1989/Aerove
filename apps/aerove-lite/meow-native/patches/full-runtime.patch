+        self.compressed
+    }
+    pub fn expanded_limit(&self) -> u64 {
+        self.expanded
+    }
+    pub fn check(&self) -> Result<(), MrsError> {
+        use std::sync::atomic::Ordering;
+        if self.cancelled_latched.load(Ordering::Acquire) || (self.cancelled)() {
