+    fn addresses() -> Vec<SocketAddr> { vec!["127.0.0.1:1".parse().unwrap(), "127.0.0.1:2".parse().unwrap()] }
+    #[tokio::test]
+    async fn concurrent_starts_every_candidate_and_drops_loser_before_return() {
+        let active = Arc::new(AtomicUsize::new(0));
+        let entered = Arc::new(AtomicUsize::new(0));
+        let result = dial_candidates(&addresses(), true, |address| {
+            let active = active.clone(); let entered = entered.clone();
+            async move {
+                active.fetch_add(1, Ordering::SeqCst); entered.fetch_add(1, Ordering::SeqCst);
+                let _guard = Active(active);
+                if address.port() == 1 { std::future::pending::<()>().await; }
+                Ok::<_, io::Error>(address.port())
+            }
+        }).await.unwrap();
+        assert_eq!(result, 2); assert_eq!(entered.load(Ordering::SeqCst), 2);
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+    }
+    #[tokio::test]
+    async fn serial_walks_each_family_in_resolver_order_and_retains_all_failures() {
+        let order = Mutex::new(Vec::new());
+        let errors = dial_candidates(&addresses(), false, |address| {
+            order.lock().unwrap().push(address.port());
+            async move { Err::<(), _>(address.port()) }
+        }).await.unwrap_err();
+        assert_eq!(*order.lock().unwrap(), vec![1, 2]); assert_eq!(errors, vec![1, 2]);
+        let both = vec!["[::1]:1".parse().unwrap(), "127.0.0.1:2".parse().unwrap()];
+        let result = dial_candidates(&both, false, |address| async move {
+            if address.is_ipv6() { std::future::pending::<()>().await; }
+            Ok::<_, io::Error>(address.port())
+        }).await.unwrap();
+        assert_eq!(result, 2);
+    }
+    #[tokio::test]
+    async fn dropping_dial_future_joins_owned_attempts_without_a_spawned_task() {
+        let active = Arc::new(AtomicUsize::new(0));
+        let endpoints = addresses();
+        let work = dial_candidates(&endpoints, true, |_| {
+            let active = active.clone();
+            async move {
+                active.fetch_add(1, Ordering::SeqCst); let _guard = Active(active);
+                std::future::pending::<Result<(), io::Error>>().await
+            }
+        });
+        assert!(tokio::time::timeout(std::time::Duration::from_millis(10), work).await.is_err());
+        assert_eq!(active.load(Ordering::SeqCst), 0);
+    }
+    #[tokio::test]
+    async fn selected_candidate_uses_real_tcp_stream_and_nonwinner_socket_is_not_retained() {
+        let origin = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let endpoint = origin.local_addr().unwrap();
+        let stream = dial_candidates(&[endpoint], true, tokio::net::TcpStream::connect).await.unwrap();
+        let (mut peer, _) = origin.accept().await.unwrap(); drop(stream);
+        let mut byte = [0u8; 1];
+        use tokio::io::AsyncReadExt;
+        assert_eq!(tokio::time::timeout(std::time::Duration::from_secs(1), peer.read(&mut byte)).await.unwrap().unwrap(), 0);
+    }
+}
