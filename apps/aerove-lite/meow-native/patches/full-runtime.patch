+        let (session, pool, mut peer, dropped) = pooled().await;
+        let held = session.streams.write().await;
+        let mut closing = Box::pin(session.close());
+        assert!(poll_fn(|cx| Poll::Ready(closing.as_mut().poll(cx).is_pending())).await);
+        assert!(session.is_closed());
+        drop(closing); drop(held);
+        session.close().await.unwrap();
+        eof(&mut peer).await;
+        assert_eq!(pool.idle_count().await, 1);
+        assert_eq!(dropped.load(Ordering::SeqCst), 0);
+        let weak = Arc::downgrade(&session); drop(session);
+        assert!(weak.upgrade().is_some()); drop(pool);
+        assert!(weak.upgrade().is_none());
+        assert_eq!(dropped.load(Ordering::SeqCst), 2);
+    }
+    #[tokio::test]
+    async fn concurrent_close_waiter_observes_completion_and_takes_over_cancelled_first_attempt() {
+        let (session, pool, mut peer, _) = pooled().await;
+        let held = session.streams.write().await;
+        let mut first = Box::pin(session.close());
+        assert!(poll_fn(|cx| Poll::Ready(first.as_mut().poll(cx).is_pending())).await);
+        let mut second = Box::pin(session.close());
+        assert!(poll_fn(|cx| Poll::Ready(second.as_mut().poll(cx).is_pending())).await);
+        drop(first); drop(held);
+        second.await.unwrap(); eof(&mut peer).await;
+        session.close().await.unwrap(); drop(pool);
+    }
