+/// One forward-only bounded source. Owned sources drop when decoding ends; borrowed sources stay with their caller.
+struct ControlledInput<'a, R> {
+    source: R,
+    consumed: u64,
+    control: &'a MrsReadControl,
+    exceeded: &'a std::cell::Cell<bool>,
+}
+impl<R: Read> Read for ControlledInput<'_, R> {
+    fn read(&mut self, buffer: &mut [u8]) -> std::io::Result<usize> {
+        self.control.check().map_err(std::io::Error::other)?;
+        if self.exceeded.get() {
+            return Err(std::io::Error::other(
+                "mrs: compressed input limit exceeded",
+            ));
+        }
+        let count = buffer
+            .len()
+            .min(64 * 1024)
+            .min((self.control.compressed.saturating_sub(self.consumed) + 1) as usize);
+        let read = self.source.read(&mut buffer[..count])?;
+        self.control.check().map_err(std::io::Error::other)?;
+        self.consumed += read as u64;
+        if self.consumed > self.control.compressed {
+            self.exceeded.set(true);
+            return Err(std::io::Error::other(
+                "mrs: compressed input limit exceeded",
+            ));
+        }
+        Ok(read)
+    }
