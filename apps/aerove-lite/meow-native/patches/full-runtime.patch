+    OpenOptions::new()
+        .write(true)
+        .open(&path)
+        .unwrap()
+        .set_modified(SystemTime::now())
+        .unwrap();
+    let current = match load(Some(86_400)) {
+        Ok(loaded) => loaded,
+        Err(error) => panic!("{error}"),
+    };
+    assert_eq!(current.rule_count(), 2);
+    assert!(matches!(
+        *current.initial_fetch.lock(),
+        provider::InitialFetch::Settled
+    ));
+    std::fs::write(&path, INVALID_UTF8).unwrap();
+    match load(Some(86_400)) {
+        Err(provider::LoadError::Acquisition(empty, error)) => {
+            let text = format!("{error:#}");
