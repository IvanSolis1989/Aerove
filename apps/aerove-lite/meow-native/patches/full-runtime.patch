+//! Session-captured defaults for application downloads, never outbound protocol TLS.
+use serde::{Deserialize, Serialize};
+use std::{cell::RefCell, future::Future, io, sync::Arc};
+
+#[derive(Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RequestPolicy { pub global_user_agent: String, pub check_certificate: bool }
+impl RequestPolicy {
+    pub fn new(global_user_agent: String, check_certificate: bool) -> io::Result<Self> {
+        let policy = Self { global_user_agent, check_certificate };
+        policy.validate()?;
+        Ok(policy)
+    }
+    pub fn validate(&self) -> io::Result<()> {
+        if self.global_user_agent.trim().is_empty() || self.global_user_agent.len() > 4096
+            || self.global_user_agent.chars().any(char::is_control) {
+            return Err(io::Error::new(io::ErrorKind::InvalidInput, "global-ua"));
+        }
+        Ok(())
+    }
+}
+impl Default for RequestPolicy {
+    fn default() -> Self { Self { global_user_agent: concat!("clash.meta/", env!("CARGO_PKG_VERSION")).into(), check_certificate: true } }
+}
+pub trait PolicySource: Send + Sync { fn snapshot(&self) -> io::Result<Arc<RequestPolicy>>; }
+#[derive(Clone)]
+pub struct PolicyScope { source: Arc<dyn PolicySource> }
+tokio::task_local! { static CURRENT: PolicyScope; }
+thread_local! { static BLOCKING: RefCell<Option<PolicyScope>> = const { RefCell::new(None) }; }
+impl PolicyScope {
+    pub fn new(source: Arc<dyn PolicySource>) -> Self { Self { source } }
+    pub async fn scope<F: Future>(&self, work: F) -> F::Output { CURRENT.scope(self.clone(), work).await }
+    pub fn run_blocking<R>(&self, work: impl FnOnce() -> R) -> R {
+        struct Restore(Option<PolicyScope>);
+        impl Drop for Restore { fn drop(&mut self) { BLOCKING.with(|slot| { slot.replace(self.0.take()); }); } }
+        let _restore = Restore(BLOCKING.with(|slot| slot.replace(Some(self.clone()))));
+        work()
+    }
+}
+pub fn current() -> io::Result<Option<Arc<RequestPolicy>>> {
+    let scope = CURRENT.try_with(Clone::clone).ok().or_else(|| BLOCKING.with(|slot| slot.borrow().clone()));
+    scope.map(|scope| { let policy = scope.source.snapshot()?; policy.validate()?; Ok(policy) }).transpose()
+}
