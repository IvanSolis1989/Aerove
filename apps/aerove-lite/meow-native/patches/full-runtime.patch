+        rx.await.unwrap();
+        let ordinary=spawn_join(Box::pin(async {assert!(!DiagnosticToken::capture().is_measurement());})).unwrap();
+        ordinary.wait().await;task.abort();assert!(task.wait().await.cancelled);
+        assert_eq!(drops.load(Ordering::SeqCst),1);assert!(!DiagnosticToken::capture().is_measurement());
+    }
+}
