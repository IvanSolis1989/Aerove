+    }
+    #[tokio::test]
+    async fn dropped_protocol_handle_remains_owned_until_actual_join() {
+        struct Guard(Arc<AtomicUsize>);
+        impl Drop for Guard { fn drop(&mut self) { self.0.fetch_sub(1, Ordering::SeqCst); } }
+        let owner = Arc::new(Owner::default()); let scope = TransportScope::new(owner.clone());
+        let active = Arc::new(AtomicUsize::new(0)); let count = active.clone();
+        let (entered, ready) = tokio::sync::oneshot::channel();
+        let task = scope.scope(async { try_spawn(async move {
