+/// Build an upstream matcher from an owned or borrowed bounded source, with per-operation cancellation.
+/// No compressed copy is retained. The reader frame and control are dropped before returning the set.
+pub fn build_checked_upstream_rule_set_from_reader<R: std::io::Read>(
+    source: R,
+    control: crate::mrs_parser::MrsReadControl,
+    expected: Option<RuleSetBehavior>,
+    sink: Option<Arc<dyn AcceptedEntrySink>>,
+) -> Result<Box<dyn RuleSet>, crate::mrs_parser::MrsError> {
+    let observer = control.clone();
+    let reader = crate::mrs_parser::UpstreamRuleSetReader::open_from_reader(source, control)?;
+    let result = build_rule_set_from_upstream_reader(reader, expected, true, sink);
+    observer.check()?;
+    result
+}
+
+/// Consume one already-decoded upstream frame and build its real matcher.
+/// Ownership releases the decoded frame before returning the independent set.
+/// This reuses the same strict validation and accepted-entry sink as the bytes factory.
+pub fn build_rule_set_from_upstream_reader(
+    reader: crate::mrs_parser::UpstreamRuleSetReader,
+    expected: Option<RuleSetBehavior>,
+    strict: bool,
+    sink: Option<Arc<dyn AcceptedEntrySink>>,
+) -> Result<Box<dyn RuleSet>, crate::mrs_parser::MrsError> {
+    use crate::mrs_parser::MrsError;
+    reader.check_cancelled()?;
+    let actual = behavior_from_type_tag(reader.behavior()).map_err(MrsError::RuleSet)?;
+    if let Some(expected) = expected {
+        if expected != actual {
+            return Err(MrsError::RuleSet(format!(
+                "mrs: behavior mismatch: config says {expected}, file says {actual}"
+            )));
+        }
+    }
+    match actual {
+        RuleSetBehavior::Domain => {
+            let mut builder = DomainRuleSetBuilder::with_sink(sink.clone());
+            let mut first_err = None;
+            reader.for_each_domain(|d| {
+                if first_err.is_none() {
+                    if strict {
+                        if let Err(e) = builder.push_checked(d) {
+                            first_err = Some(e);
+                        }
+                    } else {
+                        builder.push(d);
+                    }
+                }
+            })?;
+            if let Some(e) = first_err {
+                return Err(MrsError::RuleSet(e));
+            }
+            reader.check_cancelled()?;
+            let set = builder.build();
+            reader.check_cancelled()?;
+            Ok(Box::new(set))
+        }
+        RuleSetBehavior::IpCidr => {
+            let mut builder = IpCidrRuleSetBuilder::with_sink(sink.clone());
+            reader.for_each_net(|net| builder.push_net(net))?;
+            reader.check_cancelled()?;
+            let set = builder.build();
+            reader.check_cancelled()?;
+            Ok(Box::new(set))
+        }
+        RuleSetBehavior::Classical => Err(MrsError::RuleSet(
+            "mrs: upstream format does not support classical behavior".to_string(),
+        )),
+    }
+}
