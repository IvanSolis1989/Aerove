+/// Raw answer receipt from one actual upstream client future. The resolver
+/// attaches this exact receipt to the FamilySet that won its existing race.
+/// This retains CNAME/typed answer data instead of reconstructing it from IPs.
+#[derive(Debug)]
+pub(crate) struct DnsVerdict { records:Vec<Record>, code:Option<ResponseCode>, error:String }
+impl DnsVerdict {
+    pub(crate) fn answers(&self)->Vec<String> { self.records.iter().map(dns_answer_value).collect() }
+    pub(crate) fn rcode(&self)->String { self.code.map_or_else(String::new,|code|format!("{code:?}").to_uppercase()) }
+    pub(crate) fn error(&self)->String { self.error.clone() }
+    pub(crate) fn matches_cache(&self,neg:crate::cache::FamilyNeg)->bool {
+        self.code.is_some_and(|code|match neg {
+            crate::cache::FamilyNeg::NxDomain=>code==ResponseCode::NXDomain,
+            _=>code==ResponseCode::NoError,
+        })
+    }
+}
+pub(crate) fn dns_answer_value(record:&Record)->String {
+    match &record.data { RData::A(value)=>value.0.to_string(),RData::AAAA(value)=>value.0.to_string(),
+        RData::CNAME(value)=>value.0.to_utf8().trim_end_matches('.').to_owned(),other=>other.to_string() }
+}
+#[derive(Default)]
+pub(crate) struct QueryCapture { pub(crate) values:parking_lot::Mutex<(Option<Arc<DnsVerdict>>,Option<Arc<DnsVerdict>>)> }
+tokio::task_local! { static DNS_CAPTURE: Arc<QueryCapture>; }
+impl QueryCapture {
+    pub(crate) async fn scope<F:Future>(self:Arc<Self>,work:F)->F::Output { DNS_CAPTURE.scope(self,work).await }
+    fn record(kind:RecordType,result:&Result<Message,ClientError>) {
+        if !matches!(kind,RecordType::A|RecordType::AAAA) { return; }
