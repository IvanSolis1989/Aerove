+use parking_lot::Mutex;
+use std::sync::Arc;
+use tokio::task::{AbortHandle, JoinError, JoinHandle};
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct TaskOutcome { pub panicked: bool, pub cancelled: bool }
+#[derive(Default)]
+struct Completion {
+    done: bool,
+    taken: bool,
+    outcome: TaskOutcome,
+    error: Option<JoinError>,
+}
+pub struct SharedUnitJoin {
+    handle: tokio::sync::Mutex<Option<JoinHandle<()>>>,
+    completion: Mutex<Completion>,
+    abort: AbortHandle,
+}
+impl SharedUnitJoin {
+    pub fn new(handle: JoinHandle<()>) -> Arc<Self> {
+        let abort = handle.abort_handle();
+        Arc::new(Self { handle: tokio::sync::Mutex::new(Some(handle)), completion: Mutex::new(Completion::default()), abort })
+    }
+    pub fn abort(&self) { self.abort.abort(); }
+    pub fn abort_handle(&self) -> AbortHandle { self.abort.clone() }
+    pub fn is_finished(&self) -> bool { self.abort.is_finished() }
+    pub async fn wait(&self) -> TaskOutcome {
+        let mut handle = self.handle.lock().await;
+        let retired = if let Some(actual) = handle.as_mut() {
+            let result = actual.await;
+            {
+                let mut completion = self.completion.lock();
+                completion.outcome = TaskOutcome {
+                    panicked: result.as_ref().is_err_and(JoinError::is_panic),
+                    cancelled: result.as_ref().is_err_and(JoinError::is_cancelled),
+                };
+                completion.error = result.err();
+                completion.done = true;
+            }
+            handle.take()
+        } else { None };
+        let outcome = {
+            let completion = self.completion.lock();
+            assert!(completion.done, "unit task must actually join before completion");
+            completion.outcome
+        };
+        drop(handle);
+        drop(retired);
+        outcome
+    }
+    pub(crate) async fn join_result(&self) -> Result<(), JoinError> {
+        self.wait().await;
+        let error = {
+            let mut completion = self.completion.lock();
+            assert!(completion.done && !completion.taken, "protocol result has one consumer");
+            completion.taken = true;
+            completion.error.take()
+        };
+        match error { Some(error) => Err(error), None => Ok(()) }
+    }
+}
