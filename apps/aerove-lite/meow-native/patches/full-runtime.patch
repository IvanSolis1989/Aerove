+#[cfg(test)]
+mod scoped_owner_tests {
+    use super::*;
+    use meow_common::transport_tasks::{SharedUnitJoin, TransportScope, TransportTaskContext, Work};
+    use std::{io, sync::{Arc, Mutex}};
+    use tokio::task::AbortHandle;
+    #[derive(Default)]
+    struct State { closed: bool, tasks: Vec<Arc<SharedUnitJoin>> }
+    #[derive(Default)]
+    struct Owner(Mutex<State>);
+    impl TransportTaskContext for Owner {
+        fn spawn(&self, work: Work) -> io::Result<AbortHandle> { self.spawn_join(work).map(|task| task.abort_handle()) }
+        fn spawn_join(&self, work: Work) -> io::Result<Arc<SharedUnitJoin>> {
+            let mut state = self.0.lock().unwrap();
+            if state.closed { return Err(io::Error::other("closed")); }
+            let task = SharedUnitJoin::new(tokio::spawn(work)); state.tasks.push(task.clone()); Ok(task)
+        }
+    }
+    impl Owner {
+        async fn close(&self) {
+            let tasks = { let mut state = self.0.lock().unwrap(); state.closed = true;
+                for task in &state.tasks { task.abort(); } state.tasks.clone() };
+            for task in tasks { task.wait().await; }
+        }
+    }
+    #[tokio::test]
+    async fn actual_vmess_read_write_supervisor_are_joined_before_transport_eof_ack() {
+        use tokio::io::AsyncReadExt;
+        let owner = Arc::new(Owner::default()); let scope = TransportScope::new(owner.clone());
+        let (transport, mut peer) = tokio::io::duplex(4096);
+        let app = scope.scope(async { spawn_vmess_relay(Box::new(transport), Security::None, [1;16], [2;16], 3).unwrap() }).await;
+        assert_eq!(owner.0.lock().unwrap().tasks.len(), 3);
+        owner.close().await;
+        assert!(owner.0.lock().unwrap().tasks.iter().all(|task| task.is_finished()));
+        let mut byte = [0];
+        assert_eq!(tokio::time::timeout(std::time::Duration::from_secs(1), peer.read(&mut byte)).await.unwrap().unwrap(), 0);
+        drop(app);
+    }
+    #[tokio::test]
+    async fn closed_session_rejects_vmess_before_any_relay_task_is_spawned() {
+        use tokio::io::AsyncReadExt;
+        let owner = Arc::new(Owner::default()); owner.close().await;
+        let scope = TransportScope::new(owner.clone()); let (transport, mut peer) = tokio::io::duplex(4096);
+        let result = scope.scope(async { spawn_vmess_relay(Box::new(transport), Security::None, [1;16], [2;16], 3) }).await;
+        assert!(result.is_err()); assert!(owner.0.lock().unwrap().tasks.is_empty());
+        let mut byte = [0]; assert_eq!(peer.read(&mut byte).await.unwrap(), 0);
+    }
+}
