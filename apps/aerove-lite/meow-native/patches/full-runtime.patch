+use std::sync::{Arc, atomic::{AtomicU64, Ordering}};
+use serde::Serialize;
+static NEXT_SOURCE: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum ProviderKind { Proxy, Rule }
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct ProviderIdentity { pub kind: ProviderKind, pub name: String, pub source: u64 }
+pub trait ProviderLease: Send + Sync {
+    fn commit(&self, changed: bool, install: &mut dyn FnMut()) -> Result<(), String>;
+    /// Strict client projection before DNS pre-resolution or adapter creation.
+    /// The canonical maps continue through the real provider factory.
+    fn normalize_proxy_nodes(&self, _document: &serde_yaml::Value, _nodes: &mut Vec<std::collections::HashMap<String, serde_yaml::Value>>) -> Result<(), String> { Ok(()) }
+    /// Preflight before writing a fetched payload to cache. The managed bridge
+    /// rejects graphs whose members it cannot observe; CLI leases stay unchanged.
+    fn validate_proxy_members(&self, _members: &[Arc<dyn meow_common::Proxy>], _dialers: &[String]) -> Result<(), String> { Ok(()) }
+    /// Projected preflight runs before fetched cache/userinfo writes.
+    fn validate_proxy_projection(&self, projection: &crate::proxy_provider::ProxyProviderProjection, dialers: &[String]) -> Result<(), String> {
+        if !projection.is_current() { return Err("staleProviderProjection".into()); }
+        self.validate_proxy_members(projection.members(), dialers)
+    }
+    /// Both validation and original installation consume the same actual
+    /// factory-produced candidate. Defaults retain existing CLI/host behavior.
+    fn commit_proxy_projection(&self, projection: &crate::proxy_provider::ProxyProviderProjection, dialers: &[String], install: &mut dyn FnMut()) -> Result<(), String> {
+        if !projection.is_current() { return Err("staleProviderProjection".into()); }
+        self.commit_proxy(projection.members(), dialers, install)
+    }
+    /// Publish a typed proxy generation under the same provider commit gate.
+    fn commit_proxy(&self, members: &[Arc<dyn meow_common::Proxy>], dialers: &[String], install: &mut dyn FnMut()) -> Result<(), String> {
+        self.validate_proxy_members(members, dialers)?;
+        self.commit(true, install)
+    }
+}
+pub trait ProviderObserver: Send + Sync {
+    fn validate(&self, kind: ProviderKind, name: &str) -> Result<(), String>;
+    fn begin(&self, identity: &ProviderIdentity) -> Result<Arc<dyn ProviderLease>, String>;
+}
+#[derive(Clone)]
+pub struct ProviderBinding {
+    identity: ProviderIdentity,
+    observer: Option<Arc<dyn ProviderObserver>>,
+    scope: Option<Arc<crate::owned_load::OwnedLoadScope>>,
+}
+struct UnobservedLease;
+impl ProviderLease for UnobservedLease {
+    fn commit(&self, _changed: bool, install: &mut dyn FnMut()) -> Result<(), String> { install(); Ok(()) }
+}
+impl ProviderBinding {
+    pub fn capture(kind: ProviderKind, name: &str) -> Result<Self, String> {
+        let scope = crate::owned_load::OwnedLoadScope::current();
+        let observer = scope.as_ref().and_then(|scope| scope.provider_observer());
+        if let Some(observer) = &observer { observer.validate(kind, name)?; }
+        Ok(Self { identity: ProviderIdentity { kind, name: name.into(), source: NEXT_SOURCE.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |source| source.checked_add(1)).map_err(|_| "providerSourceExhausted".to_string())? },
+            observer, scope })
+    }
+    pub async fn run<F>(&self, work: F) -> F::Output
+    where F: std::future::Future + Send + 'static, F::Output: Send + 'static {
+        match &self.scope { Some(scope) => crate::owned_load::wrap_with(scope.clone(), work).await, None => work.await }
+    }
+    pub fn observed(&self) -> bool { self.observer.is_some() }
+    pub fn scope(&self) -> Option<Arc<crate::owned_load::OwnedLoadScope>> { self.scope.clone() }
+    pub fn identity(&self) -> &ProviderIdentity { &self.identity }
+    pub fn begin(&self) -> Result<Arc<dyn ProviderLease>, String> {
+        match &self.observer { Some(observer) => observer.begin(&self.identity), None => Ok(Arc::new(UnobservedLease)) }
+    }
+}
