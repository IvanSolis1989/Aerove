+//! Runtime-scoped API tasks; upgrades acquire their lease before Axum spawns.
+use axum::{extract::ws::{WebSocket, WebSocketUpgrade}, http::StatusCode, response::{IntoResponse, Response}};
+use parking_lot::Mutex;
+use meow_config::owned_load::{LoadContext, OwnedWork};
+use std::{future::Future, sync::Arc};
+use tokio_util::{sync::CancellationToken, task::{TaskTracker, task_tracker::TaskTrackerToken}};
+
+#[derive(Clone)]
+pub struct ApiLifecycle(Arc<Inner>);
+
+struct Inner {
+    admission: Mutex<bool>,
+    cancel: CancellationToken,
+    tasks: TaskTracker,
+    context: Option<Arc<dyn LoadContext>>,
+}
+
+impl Default for ApiLifecycle {
+    fn default() -> Self {
+        Self(Arc::new(Inner {
+            admission: Mutex::new(true),
+            cancel: CancellationToken::new(),
+            tasks: TaskTracker::new(),
+            context: None,
+        }))
+    }
+}
+
+impl ApiLifecycle {
+    /// Explicitly carry the owning Session context across Tokio/Axum task boundaries.
+    pub fn with_context(context: Arc<dyn LoadContext>) -> Self {
+        Self(Arc::new(Inner { admission: Mutex::new(true), cancel: CancellationToken::new(),
+            tasks: TaskTracker::new(), context: Some(context) }))
+    }
+
+    fn wrap(&self, task: OwnedWork) -> OwnedWork {
+        match &self.0.context { Some(context) => context.wrap(task), None => task }
+    }
+
+    fn lease(&self) -> Option<TaskTrackerToken> {
+        let open = self.0.admission.lock();
+        if !*open { return None; }
+        Some(self.0.tasks.token())
+    }
+
+    pub fn on_upgrade<F, Fut>(&self, ws: WebSocketUpgrade, callback: F) -> Response
+    where
+        F: FnOnce(WebSocket) -> Fut + Send + 'static,
+        Fut: Future<Output = ()> + Send + 'static,
+    {
+        let Some(lease) = self.lease() else {
+            return StatusCode::SERVICE_UNAVAILABLE.into_response();
+        };
+        let cancel = self.0.cancel.clone();
+        let owner = self.clone();
+        ws.on_upgrade(move |socket| owner.wrap(Box::pin(async move {
+            let _lease = lease;
+            tokio::select! {
+                biased;
+                _ = cancel.cancelled() => {},
+                _ = callback(socket) => {},
+            }
+        })))
+    }
+
+    pub fn spawn<F>(&self, task: F)
+    where F: Future<Output = ()> + Send + 'static {
+        let Some(lease) = self.lease() else { return; };
+        let cancel = self.0.cancel.clone();
+        tokio::spawn(self.wrap(Box::pin(async move {
+            let _lease = lease;
+            tokio::select! {
+                biased;
+                _ = cancel.cancelled() => {},
+                _ = task => {},
+            }
+        })));
+    }
+
+    pub fn cancel(&self) {
+        let mut open = self.0.admission.lock();
+        *open = false;
+        self.0.cancel.cancel();
+        self.0.tasks.close();
+    }
+
+    pub async fn join(&self) {
+        self.0.tasks.wait().await;
+    }
+
+    pub async fn shutdown(&self) {
+        self.cancel();
+        self.join().await;
+    }
+
+    pub fn active_tasks(&self) -> usize { self.0.tasks.len() }
+}
