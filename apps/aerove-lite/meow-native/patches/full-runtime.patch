+            head(&mut server).await;
+            server.write_all(b"HTTP/1.1 204 Final\r\n\r\n").await.unwrap(); eof(&mut server).await;
+        });
+        let now = Instant::now();
+        assert!(exchange(client, &uri, &[(204,204)], true, now, now + Duration::from_secs(1)).await.unwrap() >= 1);
+        origin.await.unwrap();
+    }
