+use std::{cell::RefCell, future::Future, io, pin::Pin, sync::Arc};
+use tokio::task::AbortHandle;
+#[path = "transport_join.rs"] mod transport_join;
+pub use transport_join::{SharedUnitJoin, TaskOutcome};
+
+/// Explicit per-operation diagnostic token. Never stored in a session owner or
+/// long-lived Spawner: each spawn captures the operation invoking it.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct DiagnosticToken(bool);
+thread_local! { static DIAGNOSTIC: std::cell::Cell<bool> = const { std::cell::Cell::new(false) }; }
+impl DiagnosticToken {
+    pub fn capture() -> Self { Self(DIAGNOSTIC.with(std::cell::Cell::get)) }
+    pub fn measurement() -> Self { Self(true) }
+    pub fn is_measurement(self) -> bool { self.0 }
+    pub fn run<T>(self, work: impl FnOnce() -> T) -> T {
+        struct Restore(bool);
+        impl Drop for Restore { fn drop(&mut self) { DIAGNOSTIC.with(|slot| slot.set(self.0)); } }
+        let _restore = Restore(DIAGNOSTIC.with(|slot| slot.replace(self.0)));
+        work()
+    }
+    pub fn scope<F: Future>(self, work: F) -> DiagnosticFuture<F> {
+        DiagnosticFuture { token: self, future: Some(Box::pin(work)) }
+    }
+    fn wrap(self, work: Work) -> Work { Box::pin(self.scope(work)) }
+}
+/// Re-enters on each poll AND on destruction, including abort outside the
+/// original scope. Pending futures never leave a thread-wide mute installed.
+pub struct DiagnosticFuture<F: Future> {
+    token: DiagnosticToken, future: Option<Pin<Box<F>>>,
+}
+impl<F: Future> Future for DiagnosticFuture<F> {
+    type Output = F::Output;
+    fn poll(self: Pin<&mut Self>, cx: &mut std::task::Context<'_>) -> std::task::Poll<Self::Output> {
+        let this = self.get_mut();
+        this.token.run(|| this.future.as_mut().expect("diagnostic future already dropped").as_mut().poll(cx))
+    }
+}
+impl<F: Future> Drop for DiagnosticFuture<F> {
+    fn drop(&mut self) { self.token.run(|| drop(self.future.take())); }
+}
+
+pub type Work = Pin<Box<dyn Future<Output = ()> + Send + 'static>>;
+pub trait TransportTaskContext: Send + Sync {
+    fn wrap(&self, work: Work) -> Work { work }
+    fn spawn(&self, work: Work) -> io::Result<AbortHandle>;
+    fn spawn_join(&self, _work: Work) -> io::Result<Arc<SharedUnitJoin>> {
+        Err(io::Error::other("transportJoinOwnerMissing"))
+    }
+}
+
+#[derive(Clone)]
+pub struct TransportScope(Arc<dyn TransportTaskContext>);
+tokio::task_local! { static CURRENT: TransportScope; }
+thread_local! { static BLOCKING: RefCell<Option<TransportScope>> = const { RefCell::new(None) }; }
+
+impl TransportScope {
+    pub fn new(context: Arc<dyn TransportTaskContext>) -> Self { Self(context) }
+    pub fn require_owner() -> Self {
+        struct MissingOwner;
+        impl TransportTaskContext for MissingOwner {
+            fn spawn(&self, _work: Work) -> io::Result<AbortHandle> {
+                Err(io::Error::other("capturedTransportOwnerMissing"))
+            }
+            fn spawn_join(&self, _work: Work) -> io::Result<Arc<SharedUnitJoin>> {
+                Err(io::Error::other("capturedTransportOwnerMissing"))
+            }
+        }
+        Self::current().unwrap_or_else(|| Self::new(Arc::new(MissingOwner)))
+    }
+    pub fn wrap(&self, work: Work) -> Work { DiagnosticToken::capture().wrap(self.0.wrap(work)) }
+    pub fn spawn(&self, work: Work) -> io::Result<AbortHandle> { self.0.spawn(DiagnosticToken::capture().wrap(work)) }
+    pub fn spawn_join(&self, work: Work) -> io::Result<Arc<SharedUnitJoin>> { self.0.spawn_join(DiagnosticToken::capture().wrap(work)) }
+    pub fn current() -> Option<Self> {
+        CURRENT.try_with(Clone::clone).ok().or_else(|| BLOCKING.with(|slot| slot.borrow().clone()))
+    }
+    pub async fn scope<F: Future>(&self, work: F) -> F::Output { DiagnosticToken::capture().scope(CURRENT.scope(self.clone(), work)).await }
+    pub fn run_blocking<T>(&self, work: impl FnOnce() -> T) -> T {
+        struct Restore(Option<TransportScope>);
+        impl Drop for Restore {
+            fn drop(&mut self) { let retired = BLOCKING.with(|slot| slot.replace(self.0.take())); drop(retired); }
+        }
+        let _restore = Restore(BLOCKING.with(|slot| slot.replace(Some(self.clone()))));
+        work()
+    }
+}
+
+pub fn spawn(work: Work) -> io::Result<AbortHandle> {
+    if let Some(scope) = TransportScope::current() { return scope.spawn(work); }
+    Ok(tokio::spawn(DiagnosticToken::capture().wrap(work)).abort_handle())
+}
+
+pub fn spawn_join(work: Work) -> io::Result<Arc<SharedUnitJoin>> {
+    if let Some(scope) = TransportScope::current() { return scope.spawn_join(work); }
+    Ok(SharedUnitJoin::new(tokio::spawn(DiagnosticToken::capture().wrap(work))))
+}
+
+/// Re-enter the same session's live context for one caller-owned operation.
+/// This creates no task and keeps cancellation with the calling future.
+pub fn wrap_current(work: Work) -> Work {
+    match TransportScope::current() { Some(scope) => scope.wrap(work), None => DiagnosticToken::capture().wrap(work) }
+}
+
+#[cfg(test)]
+mod diagnostic_tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+    struct OnDrop(Arc<AtomicUsize>);
+    impl Drop for OnDrop {
+        fn drop(&mut self) { assert!(DiagnosticToken::capture().is_measurement());self.0.fetch_add(1,Ordering::SeqCst); }
+    }
+    #[tokio::test]
+    async fn diagnostic_future_drop_outside_scope_restores_only_its_own_context() {
+        let drops=Arc::new(AtomicUsize::new(0));let count=drops.clone();
+        let mut measured=Box::pin(DiagnosticToken::measurement().scope(async move {
+            let _guard=OnDrop(count);std::future::pending::<()>().await;
+        }));
+        std::future::poll_fn(|cx| { assert!(measured.as_mut().poll(cx).is_pending());std::task::Poll::Ready(()) }).await;
+        assert!(!DiagnosticToken::capture().is_measurement());
+        drop(measured);assert_eq!(drops.load(Ordering::SeqCst),1);assert!(!DiagnosticToken::capture().is_measurement());
+        let panic=std::panic::catch_unwind(|| DiagnosticToken::measurement().run(|| panic!("fixture")));
+        assert!(panic.is_err());assert!(!DiagnosticToken::capture().is_measurement());
+    }
+    #[tokio::test(flavor="multi_thread",worker_threads=2)]
+    async fn diagnostic_spawn_abort_inherits_token_without_muting_parallel_business() {
+        let drops=Arc::new(AtomicUsize::new(0));let count=drops.clone();let(tx,rx)=tokio::sync::oneshot::channel();
+        let task=DiagnosticToken::measurement().scope(async {
+            spawn_join(Box::pin(async move {assert!(DiagnosticToken::capture().is_measurement());
+                let _guard=OnDrop(count);tx.send(()).unwrap();std::future::pending::<()>().await;
+            })).unwrap()
+        }).await;
+        rx.await.unwrap();
+        let ordinary=spawn_join(Box::pin(async {assert!(!DiagnosticToken::capture().is_measurement());})).unwrap();
+        ordinary.wait().await;task.abort();assert!(task.wait().await.cancelled);
+        assert_eq!(drops.load(Ordering::SeqCst),1);assert!(!DiagnosticToken::capture().is_measurement());
+    }
+}
