+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ProbePolicy { pub unified_delay: bool, pub tcp_concurrent: bool }
+impl Default for ProbePolicy {
+    fn default() -> Self { Self { unified_delay: true, tcp_concurrent: true } }
+}
+pub trait ProbeSource: Send + Sync {
+    fn snapshot(&self) -> io::Result<Arc<ProbePolicy>>;
+    fn snapshot_with_epoch(&self) -> io::Result<(Arc<ProbePolicy>, Option<u64>)> {
+        Ok((self.snapshot()?, None))
+    }
+    fn enter(&self) -> io::Result<Box<dyn Send>> { Ok(Box::new(())) }
+    fn cancelled(&self) -> Pin<Box<dyn Future<Output = ()> + Send + '_>>;
+}
+#[derive(Clone)]
+pub struct ProbeScope { source: Arc<dyn ProbeSource> }
+#[derive(Clone)]
+pub struct ProbeSnapshot { pub policy: Arc<ProbePolicy>, core_epoch: Option<u64>, owner: ProbeScope }
+tokio::task_local! { static OWNER: ProbeScope; static OPERATION: ProbeSnapshot; }
+impl ProbeScope {
+    pub fn new(source: Arc<dyn ProbeSource>) -> Self { Self { source } }
+    pub fn capture() -> Option<Self> { OWNER.try_with(Clone::clone).ok() }
+    pub async fn scope<F: Future>(&self, work: F) -> F::Output { OWNER.scope(self.clone(), work).await }
+    pub async fn run_owned<F: Future>(&self, work: F) -> io::Result<F::Output> {
+        let _lease = self.source.enter()?;
+        self.scope(async { tokio::select! { biased;
+            _ = self.source.cancelled() => Err(io::Error::from(io::ErrorKind::Interrupted)),
+            result = work => Ok(result),
+        }}).await
+    }
+    pub fn snapshot(&self) -> io::Result<ProbeSnapshot> {
+        let (policy, core_epoch) = self.source.snapshot_with_epoch()?;
+        Ok(ProbeSnapshot { policy, core_epoch, owner: self.clone() })
+    }
+}
+impl ProbeSnapshot {
+    pub fn lease(&self) -> io::Result<Box<dyn Send>> { self.owner.source.enter() }
+    pub async fn scope<F: Future>(&self, work: F) -> F::Output {
+        self.owner.scope(OPERATION.scope(self.clone(), work)).await
+    }
+    pub async fn run<T>(&self, work: impl Future<Output = io::Result<T>>) -> io::Result<T> {
+        let _lease = self.lease()?;
+        self.scope(async {
+            tokio::select! { biased;
+                _ = self.owner.source.cancelled() => Err(io::Error::from(io::ErrorKind::Interrupted)),
+                result = work => result,
+            }
+        }).await
+    }
+    pub async fn cancelled(&self) { self.owner.source.cancelled().await; }
+}
+pub fn capture() -> io::Result<Option<ProbeSnapshot>> {
+    if let Ok(snapshot) = OPERATION.try_with(Clone::clone) {
+        let (_, current_epoch) = snapshot.owner.source.snapshot_with_epoch()?;
+        if snapshot.core_epoch.is_some() && snapshot.core_epoch != current_epoch {
+            return Err(io::Error::new(io::ErrorKind::Interrupted, "staleProbeEpoch"));
+        }
+        return Ok(Some(snapshot));
+    }
+    ProbeScope::capture().map(|scope| scope.snapshot()).transpose()
+}
+
+pub async fn dial_candidates<T, E, F, Fut>(addresses: &[SocketAddr], concurrent: bool, dial: F)
+    -> Result<T, Vec<E>>
+where T: Send, E: Send, F: Fn(SocketAddr) -> Fut + Sync, Fut: Future<Output = Result<T, E>> + Send {
+    let groups = if concurrent { addresses.iter().map(|address| vec![*address]).collect::<Vec<_>>() }
+        else { vec![addresses.iter().copied().filter(SocketAddr::is_ipv6).collect(),
+                    addresses.iter().copied().filter(SocketAddr::is_ipv4).collect()] };
+    let mut attempts = FuturesUnordered::new();
+    for group in groups.into_iter().filter(|group| !group.is_empty()) {
+        let dial = &dial;
+        attempts.push(async move {
+            let mut errors = Vec::new();
+            for address in group {
+                match dial(address).await { Ok(stream) => return Ok(stream), Err(error) => errors.push(error) }
+            }
+            Err(errors)
+        });
+    }
+    let mut errors = Vec::new();
+    while let Some(result) = attempts.next().await {
+        match result { Ok(stream) => return Ok(stream), Err(group) => errors.extend(group) }
+    }
+    Err(errors)
+}
