+use bytes::Bytes;
+use http_body_util::Empty;
+use hyper::{Request, StatusCode};
+use hyper_util::rt::TokioIo;
+use meow_common::{Metadata, ProxyAdapter, probe_policy::ProbeSnapshot};
+use meow_transport::{Transport as _, tls::{TlsConfig, TlsLayer}};
+use std::{io, time::Duration};
+use tokio::io::{AsyncRead, AsyncWrite};
+use tokio::time::Instant;
+use crate::health::UrlTestError;
+
+pub(crate) fn parameters(url: &str, expected: Option<&str>) -> Result<(hyper::Uri, Vec<(u16,u16)>), UrlTestError> {
+    let uri: hyper::Uri = url.parse().map_err(|_| UrlTestError::Transport("invalid probe URL".into()))?;
+    let scheme = uri.scheme_str().unwrap_or("");
+    if !matches!(scheme, "http" | "https") || uri.authority().is_none() {
+        return Err(UrlTestError::Transport("invalid probe URL".into()));
+    }
+    uri.host().ok_or_else(|| UrlTestError::Transport("missing probe host".into()))?;
+    let ranges = if expected.is_none_or(|value| value.trim().is_empty()) { vec![(100, 599)] }
+        else { crate::health::parse_expected(expected).map_err(UrlTestError::Transport)? };
+    Ok((uri, ranges))
+}
+
+pub(crate) async fn run(adapter: &dyn ProxyAdapter, url: &str, expected: Option<&str>,
+    timeout: Duration, snapshot: ProbeSnapshot) -> Result<u16, UrlTestError> {
+    let _lease = snapshot.lease().map_err(|_| UrlTestError::Transport("probe owner closed".into()))?;
+    let (uri, ranges) = parameters(url, expected)?;
+    let scheme = uri.scheme_str().unwrap_or("");
+    let host = uri.host().expect("parameters validated host");
+    let metadata = Metadata { network: meow_common::Network::Tcp, conn_type: meow_common::ConnType::Tunnel,
+        host: host.into(), dst_port: uri.port_u16().unwrap_or(if scheme == "https" {443} else {80}), ..Default::default() };
+    let start = Instant::now();
+    let deadline = start + timeout;
+    let measured = snapshot.scope(async {
+        let stream = adapter.dial_tcp(&metadata).await.map_err(io::Error::other)?;
+        if scheme == "https" {
+            let tls = TlsLayer::new(&TlsConfig::new(host.to_owned())).map_err(io::Error::other)?;
+            let stream = tls.connect(Box::new(stream)).await.map_err(io::Error::other)?;
+            exchange(stream, &uri, &ranges, snapshot.policy.unified_delay, start, deadline).await
+        } else { exchange(stream, &uri, &ranges, snapshot.policy.unified_delay, start, deadline).await }
+    });
+    tokio::pin!(measured);
+    tokio::select! { biased;
+        _ = snapshot.cancelled() => Err(UrlTestError::Transport("probe owner closed".into())),
+        result = &mut measured => result.map_err(|error| UrlTestError::Transport(error.to_string())),
+        _ = tokio::time::sleep_until(deadline) => Err(UrlTestError::Timeout),
+    }
+}
+
+pub(crate) async fn exchange<S>(stream: S, uri: &hyper::Uri, ranges: &[(u16, u16)], unified: bool,
+    start: Instant, deadline: Instant) -> io::Result<u16>
+where S: AsyncRead + AsyncWrite + Unpin + Send + 'static {
+    let request = || Request::head(uri.path_and_query().map_or("/", |path| path.as_str()))
+        .header(hyper::header::HOST, uri.authority().ok_or_else(|| io::Error::other("missing probe authority"))?.as_str())
+        .body(Empty::<Bytes>::new()).map_err(io::Error::other);
+    let (mut sender, connection) = hyper::client::conn::http1::handshake(TokioIo::new(stream)).await.map_err(io::Error::other)?;
+    let query = async {
+        let first_response = sender.send_request(request()?).await.map_err(io::Error::other)?;
+        let mut status = first_response.status();
+        drop(first_response);
+        let first = start.elapsed();
+        let mut measured = first;
+        if unified {
+            let second = Instant::now();
+            match tokio::time::timeout_at(deadline, async {
+                sender.ready().await.map_err(io::Error::other)?;
+                sender.send_request(request()?).await.map_err(io::Error::other)
+            }).await {
+                Ok(Ok(response)) => { status = response.status(); drop(response); measured = second.elapsed(); }
+                _ => {}
+            }
+        }
+        if !accepted(status, ranges) { return Err(io::Error::other("unexpected probe status")); }
+        Ok(measured.as_millis().min(u16::MAX as u128).max(1) as u16)
+    };
+    tokio::pin!(query, connection);
+    tokio::select! { biased;
+        result = &mut query => result,
+        _ = &mut connection => query.await,
+    }
+}
+fn accepted(status: StatusCode, ranges: &[(u16,u16)]) -> bool {
+    ranges.iter().any(|(low, high)| *low <= status.as_u16() && status.as_u16() <= *high)
+}
