+fn hash_payload(bytes: &[u8]) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut hash = std::collections::hash_map::DefaultHasher::new();
+    bytes.hash(&mut hash);
+    hash.finish()
+}
+fn capture_pages(
+    binding: &crate::provider_events::ProviderBinding,
+) -> Result<Option<Arc<PageCapture>>> {
+    if !binding.observed() {
+        return Ok(None);
+    }
+    let scope = binding
+        .scope()
+        .ok_or_else(|| anyhow!("providerOwnerMissing"))?;
+    let roots = scope
+        .provider_roots()
+        .map_err(anyhow::Error::msg)?
+        .ok_or_else(|| anyhow!("providerCacheRootMissing"))?;
+    PageCapture::create(&roots.cache_root)
+        .map(Some)
+        .map_err(anyhow::Error::msg)
+}
+fn parse_prefetched(
+    entry: &Prefetched,
+    behavior: RuleSetBehavior,
+    format: Option<RuleSetFormat>,
+    ctx: &ParserContext,
+    strict: bool,
+    binding: &crate::provider_events::ProviderBinding,
+) -> Result<ParsedPayload> {
+    match entry {
+        Prefetched::Opened(source) | Prefetched::CachedFile { source, .. } => {
+            source.parse(behavior, format, ctx, strict, binding)
+        }
+        _ => parse_for_provider(
+            entry
+                .bytes()
+                .ok_or_else(|| anyhow!("providerPayloadUnavailable"))?,
+            behavior,
+            format,
+            ctx,
+            strict,
+            binding,
+        ),
+    }
+}
+fn parse_for_provider(
+    bytes: &[u8],
+    behavior: RuleSetBehavior,
+    format: Option<RuleSetFormat>,
+    ctx: &ParserContext,
+    strict: bool,
+    binding: &crate::provider_events::ProviderBinding,
+) -> Result<ParsedPayload> {
+    if bytes.starts_with(&meow_rules::mrs_parser::ZSTD_MAGIC) {
+        return reader::parse_upstream(
+            std::io::Cursor::new(bytes),
+            behavior,
+            strict,
+            binding,
+            hash_payload(bytes),
+        );
+    }
+    let capture = capture_pages(binding)?;
+    let sink = capture
+        .as_ref()
+        .map(|capture| capture.clone() as Arc<dyn meow_rules::rule_set::AcceptedEntrySink>);
+    let (rules, format) = parse_bytes_with_sink(bytes, behavior, format, ctx, strict, sink)?;
+    let pages = capture
+        .map(|capture| capture.finish(rules.len()))
+        .transpose()
+        .map_err(anyhow::Error::msg)?;
+    Ok((rules, format, pages, hash_payload(bytes), None))
+}
+
+fn owned_http_paths(
+    cfg: &RawRuleProvider,
+    name: &str,
+    roots: &crate::owned_load::ProviderRoots,
+) -> Result<(Option<PathBuf>, Option<PathBuf>)> {
+    let default = Path::new("rule-providers").join(format!("{name}.yaml"));
+    let requested = cfg
+        .path
+        .as_deref()
+        .map(Path::new)
+        .unwrap_or(default.as_path());
+    if let Ok(path) = crate::safe_path::resolve_contained_strict(&roots.cache_root, requested) {
+        return Ok((Some(path), None));
+    }
+    let read = roots
+        .resource_read_root
+        .as_deref()
+        .ok_or_else(|| anyhow!("providerReadRootMissing"))?;
+    let seed =
+        crate::safe_path::resolve_contained_strict(read, requested).map_err(anyhow::Error::msg)?;
+    let relative = seed
+        .strip_prefix(read)
+        .map_err(|_| anyhow!("providerSeedOutsideReadRoot"))?;
+    let cache = crate::safe_path::resolve_contained_strict(&roots.cache_root, relative)
+        .map_err(anyhow::Error::msg)?;
+    Ok((Some(cache), Some(seed)))
+}
+fn read_initial_cache(
+    cfg: &RawRuleProvider,
+    _cache_dir: Option<&Path>,
+    name: &str,
+    cache: Option<&Path>,
+) -> Option<Prefetched> {
+    if let Some(cached) = read_cache(cache) {
+        return Some(cached);
+    }
+    let scope = crate::owned_load::OwnedLoadScope::current()?;
+    let roots = scope.provider_roots().ok()??;
+    let (_, seed) = owned_http_paths(cfg, name, &roots).ok()?;
+    read_cache(seed.as_deref())
+}
