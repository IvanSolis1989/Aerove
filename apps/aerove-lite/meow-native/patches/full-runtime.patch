+            MrsReadControl::new(u64::MAX, u64::MAX, move || {
+                probe.load(std::sync::atomic::Ordering::SeqCst)
+            }),
+        )
+        .unwrap();
+        let mut emitted = 0;
+        let error = reader
+            .for_each_net(|net| {
+                assert_eq!(net.to_string(), "192.168.0.0/24");
+                emitted += 1;
+                cancel.store(true, std::sync::atomic::Ordering::SeqCst);
+            })
+            .err()
+            .unwrap();
