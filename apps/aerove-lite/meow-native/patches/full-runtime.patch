+        fn cancelled(&self) -> std::pin::Pin<Box<dyn std::future::Future<Output=()> + Send + '_>> { Box::pin(std::future::pending()) }
+    }
+    #[tokio::test]
+    async fn hot_policy_changes_the_real_next_probe_but_not_the_captured_inflight_probe() {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let url = format!("http://{}/probe?x=1", listener.local_addr().unwrap());
+        let source = std::sync::Arc::new(MutableSource { policy: parking_lot::RwLock::new(std::sync::Arc::new(Default::default())) });
+        let scope = meow_common::probe_policy::ProbeScope::new(source.clone());
+        let changing = source.clone();
+        let origin = tokio::spawn(async move {
+            let (mut first, _) = listener.accept().await.unwrap();
