+        expanded: u64,
+        cancelled: impl Fn() -> bool + Send + Sync + 'static,
+    ) -> Self {
+        Self {
+            compressed: compressed.min(MAX_DECOMPRESSED_BYTES),
+            expanded: expanded.min(MAX_DECOMPRESSED_BYTES),
+            admission: None,
+            cancelled: std::sync::Arc::new(cancelled),
+            cancelled_latched: Default::default(),
+        }
+    }
