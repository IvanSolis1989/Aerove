+impl ProviderLease for Lease {
+    fn commit(&self, _changed: bool, install: &mut dyn FnMut()) -> Result<(), String> {
+        if self.current.load(Ordering::Acquire) != self.epoch {
+            return Err("staleProviderSource".into());
+        }
+        install();
+        Ok(())
+    }
