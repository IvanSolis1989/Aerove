+use std::{future::Future,io,pin::Pin,sync::Arc};
+
+pub type EchQuery<'a> = Pin<Box<dyn Future<Output=io::Result<Vec<u8>>>+Send+'a>>;
+/// The embedding owner supplies one already captured resolver generation.
+/// Queries must stay with that owner; this interface never looks up a global.
+pub trait EchSource: Send+Sync {
+    fn query<'a>(&'a self,name:&'a str)->EchQuery<'a>;
+}
+#[derive(Clone)]
+pub struct EchScope { source:Arc<dyn EchSource>, lineage:Arc<Vec<String>> }
+tokio::task_local! { static CURRENT: EchScope; }
+impl EchScope {
+    pub fn new(source:Arc<dyn EchSource>)->Self {Self{source,lineage:Arc::new(Vec::new())}}
+    pub fn current()->Option<Self>{CURRENT.try_with(Clone::clone).ok()}
+    /// A new request/flow may replace its resolver while retaining an outer
+    /// query ancestry. Resolver-owned children propagate that outer scope
+    /// explicitly with wrap_current, never by assuming spawn inherits it.
+    pub fn scope<'a,F>(&self,work:F)->Pin<Box<dyn Future<Output=F::Output>+Send+'a>>
+    where F:Future+Send+'a,F::Output:Send+'a {
+        let mut captured=self.clone();
+        if let Some(parent)=Self::current(){captured.lineage=parent.lineage;}
+        captured.scope_exact(work)
+    }
+    fn scope_exact<'a,F>(self,work:F)->Pin<Box<dyn Future<Output=F::Output>+Send+'a>>
+    where F:Future+Send+'a,F::Output:Send+'a {
+        let work:Pin<Box<dyn Future<Output=F::Output>+Send+'a>>=Box::pin(work);
+        Box::pin(async move{CURRENT.scope(self,work).await})
+    }
+    /// Capture at task creation, then enter on its first poll. The actual
+    /// task must still be registered/joined by the existing transport owner.
+    pub fn wrap_current<'a,F>(work:F)->Pin<Box<dyn Future<Output=F::Output>+Send+'a>>
+    where F:Future+Send+'a,F::Output:Send+'a {
+        let work:Pin<Box<dyn Future<Output=F::Output>+Send+'a>>=Box::pin(work);
+        match Self::current(){Some(scope)=>scope.scope_exact(work),None=>work}
+    }
+    pub fn resolve(name:String)->EchQuery<'static>{
+        Box::pin(async move{
+            let Some(scope)=Self::current() else{return Err(io::Error::new(io::ErrorKind::NotConnected,"echResolverScopeMissing"));};
+            let key=name.trim_end_matches('.').to_ascii_lowercase();
+            if key.is_empty()||key.contains('\0'){return Err(io::Error::new(io::ErrorKind::InvalidInput,"echQueryNameInvalid"));}
+            if scope.lineage.len()>=16||scope.lineage.iter().any(|ancestor|ancestor==&key){
+                return Err(io::Error::new(io::ErrorKind::InvalidInput,"echDnsCycle"));
+            }
+            let mut names=(*scope.lineage).clone();names.push(key);
+            let source=scope.source.clone();let nested=Self{source:source.clone(),lineage:Arc::new(names)};
+            let bytes=nested.scope_exact(async move{source.query(&name).await}).await?;
+            if bytes.is_empty()||bytes.len()>u16::MAX as usize{
+                return Err(io::Error::new(io::ErrorKind::InvalidData,"echConfigListInvalidLength"));
+            }
+            Ok(bytes)
+        })
+    }
+}
