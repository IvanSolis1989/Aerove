+        })();
+        if let Err(error) = result {
+            state.error = Some(error);
+        }
+    }
+}
+impl RulePages {
+    pub fn count(&self) -> usize {
+        self.count
+    }
+    /// Compare the exact accepted stream with bounded buffers, outside commit.
+    pub fn same_entries(&self, other: &Self) -> Result<bool, String> {
+        if std::ptr::eq(self, other) {
+            return Ok(true);
+        }
+        if self.count != other.count {
+            return Ok(false);
+        }
+        // Both candidates are immutable. Independent handles avoid locking a
+        // live page reader or acquiring two RulePages locks in reverse order.
+        let mut left =
+            File::open(&self.paths[0]).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let mut right =
+            File::open(&other.paths[0]).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let mut a = [0; 16384];
+        let mut b = [0; 16384];
+        loop {
+            let length = left
+                .read(&mut a)
+                .map_err(|error| format!("rulePageStorage: {error}"))?;
+            if length == 0 {
+                return Ok(right
+                    .read(&mut b[..1])
+                    .map_err(|error| format!("rulePageStorage: {error}"))?
+                    == 0);
+            }
+            if let Err(error) = right.read_exact(&mut b[..length]) {
+                if error.kind() == std::io::ErrorKind::UnexpectedEof {
+                    return Ok(false);
+                }
+                return Err(format!("rulePageStorage: {error}"));
+            }
+            if a[..length] != b[..length] {
+                return Ok(false);
+            }
+        }
+    }
+    pub fn page(&self, offset: usize, limit: usize) -> Result<RulePage, String> {
+        if limit == 0 || limit > 10000 {
+            return Err("invalidRulePageLimit".into());
+        }
+        let mut rows = Vec::new();
+        let mut files = self.files.lock();
+        let (data, index) = files.as_mut().ok_or("rulePageStorageClosed")?;
+        let end = offset.saturating_add(limit).min(self.count);
+        if offset < self.count {
+            let position = u64::try_from(offset)
+                .ok()
+                .and_then(|offset| offset.checked_mul(8))
+                .ok_or("invalidRulePageOffset")?;
+            index
+                .seek(SeekFrom::Start(position))
+                .map_err(|error| format!("rulePageStorage: {error}"))?;
+            rows.reserve(end - offset);
+            for _ in offset..end {
+                let mut raw = [0; 8];
+                index
+                    .read_exact(&mut raw)
+                    .map_err(|error| format!("rulePageStorage: {error}"))?;
+                data.seek(SeekFrom::Start(u64::from_le_bytes(raw)))
+                    .map_err(|error| format!("rulePageStorage: {error}"))?;
+                let mut length = [0; 4];
+                data.read_exact(&mut length)
+                    .map_err(|error| format!("rulePageStorage: {error}"))?;
+                let mut bytes = vec![0; u32::from_le_bytes(length) as usize];
+                data.read_exact(&mut bytes)
+                    .map_err(|error| format!("rulePageStorage: {error}"))?;
+                rows.push(String::from_utf8(bytes).map_err(|_| "rulePageStorageInvalidUtf8")?);
+            }
+        }
+        let complete = offset >= self.count || end >= self.count;
+        Ok(RulePage {
+            rules: rows,
+            rule_count: self.count,
+            offset,
+            next_offset: (!complete).then_some(end),
+            complete,
+        })
+    }
+}
+impl Drop for CaptureState {
+    fn drop(&mut self) {
+        drop(self.data.take());
+        drop(self.index.take());
+        if let Some(paths) = self.paths.take() {
+            for path in paths {
+                let _ = std::fs::remove_file(path);
+            }
+        }
+    }
+}
+impl Drop for RulePages {
+    fn drop(&mut self) {
+        drop(self.files.get_mut().take());
+        for path in &self.paths {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+}
