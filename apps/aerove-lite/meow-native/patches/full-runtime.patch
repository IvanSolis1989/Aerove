+use crate::owned_load::{LoadContext, OwnedLoadScope, OwnedWork};
+use hickory_proto::{op::{Message, MessageType, OpCode}, rr::{Record, RData, rdata::A}};
+use std::{net::{Ipv4Addr, SocketAddr}, sync::Arc, time::Duration};
+use tokio::{io::{AsyncReadExt, AsyncWriteExt}, net::{TcpListener, UdpSocket}, sync::Notify};
+
+struct PhysicalContext(Option<Vec<SocketAddr>>);
+impl LoadContext for PhysicalContext {
+    fn requires_physical_dns(&self) -> bool { true }
+    fn physical_dns_servers(&self) -> Option<Vec<SocketAddr>> { self.0.clone() }
+    fn wrap(&self, work: OwnedWork) -> OwnedWork { work }
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>) { work(); }
+}
+fn scope(servers: Option<Vec<SocketAddr>>) -> Arc<OwnedLoadScope> {
+    OwnedLoadScope::with_context(Arc::new(PhysicalContext(servers)))
+}
+fn response(request: &Message, truncated: bool) -> Vec<u8> {
+    let mut reply = Message::new(request.metadata.id, MessageType::Response, OpCode::Query);
+    reply.add_queries(request.queries.iter().cloned());
+    reply.metadata.truncation = truncated;
+    if !truncated {
+        reply.add_answer(Record::from_rdata(request.queries[0].name.clone(), 60,
+            RData::A(A(Ipv4Addr::new(192, 0, 2, 42)))));
+    }
+    reply.to_bytes().unwrap()
+}
+
+async fn round_trip(bind: &str, tcp_retry: bool, use_hosts: bool) {
+    let tcp = TcpListener::bind(bind).await.unwrap();
+    let address = tcp.local_addr().unwrap();
+    let udp = UdpSocket::bind(address).await.unwrap();
+    let expected_name = if use_hosts { "wire.example." } else { "pinned.example." };
+    let server = tokio::spawn(async move {
+        let mut buffer = [0; 4096];
+        let (length, peer) = udp.recv_from(&mut buffer).await.unwrap();
+        let query = Message::from_bytes(&buffer[..length]).unwrap();
+        assert_eq!(query.queries[0].name.to_string(), expected_name);
+        udp.send_to(&response(&query, tcp_retry), peer).await.unwrap();
+        if tcp_retry {
+            let (mut stream, _) = tcp.accept().await.unwrap();
+            let length = stream.read_u16().await.unwrap();
+            let mut wire = vec![0; usize::from(length)];
+            stream.read_exact(&mut wire).await.unwrap();
+            let query = Message::from_bytes(&wire).unwrap();
+            assert_eq!(query.queries[0].name.to_string(), expected_name);
+            let reply = response(&query, false);
+            stream.write_u16(reply.len().try_into().unwrap()).await.unwrap();
+            stream.write_all(&reply).await.unwrap();
+        }
+    });
+    let owner = scope(Some(vec![address]));
+    let yaml = format!("strict: true\nipv6: false\nhosts:\n  pinned.example: 192.0.2.9\ndns:\n  enable: false\n  use-hosts: {use_hosts}\nrules: ['MATCH,DIRECT']\n");
+    let config = crate::load_config_from_str_owned(&yaml, &owner).await.unwrap();
+    assert!(!config.dns.enabled);
+    assert!(config.dns.listen_addr.is_none());
+    assert_eq!(config.raw.dns.as_ref().unwrap().enable, Some(false));
+    if use_hosts {
+        assert_eq!(config.dns.resolver.lookup_ipv4("pinned.example").await,
+            Some("192.0.2.9".parse().unwrap()));
+    }
+    assert_eq!(config.dns.resolver.lookup_ipv6("pinned.example").await, None);
+    let name = if use_hosts { "wire.example" } else { "pinned.example" };
+    let answer = tokio::time::timeout(Duration::from_secs(5), owner.run(config.dns.resolver.lookup_ipv4(name))).await.unwrap();
+    assert_eq!(answer, Some("192.0.2.42".parse().unwrap()));
+    tokio::time::timeout(Duration::from_secs(5), server).await.unwrap().unwrap();
+    owner.close().await.unwrap();
+}
