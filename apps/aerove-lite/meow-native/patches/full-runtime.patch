+/// DNS transport trackers are notification-only, like Standard pushToManager=false:
+/// they do not enter the connection table or change the tunnel's existing byte totals.
+/// The tracker follows an actual socket, including its time in a TCP idle pool.
+pub struct InternalRequest {
+    feed: Arc<ObservationFeed>, id: Arc<str>, counts: Mutex<(u64,u64)>,
+}
+impl ObservationFeed {
+    pub fn internal_request(self: &Arc<Self>, metadata: crate::Metadata, chains: Vec<Arc<str>>) -> Option<InternalRequest> {
+        let sequence = {
+            let mut state=self.state.lock();
+            if state.stopped { return None; }
+            if state.request >= 0xffff_ffff_ffff { state.stopped=true;let _=self.sender.send(Event { cursor:state.cursor,value:None });return None; }
+            state.request+=1;state.request
+        };
+        // Session UUID prefix plus a non-reused 48-bit socket sequence: opaque,
+        // canonical UUIDs without a process-global ID source or another registry.
+        let prefix=self.session_id.get(..24).unwrap_or("00000000-0000-4000-8000-");
+        let id=format!("{prefix}{sequence:012x}");
+        self.publish("request",||json!({"id":id,"start":timestamp(),"metadata":metadata,"chains":chains,
+            "rule":"","rulePayload":"","upload":"0","download":"0"}));
+        Some(InternalRequest { feed:Arc::clone(self),id:id.into(),counts:Mutex::new((0,0)) })
+    }
+}
+impl InternalRequest {
+    pub fn upload(&self, n: usize) { self.record(n,true); }
+    pub fn download(&self, n: usize) { self.record(n,false); }
+    fn record(&self, n: usize, upload: bool) {
+        if n==0 { return; }
+        {let mut counts=self.counts.lock();if upload { counts.0=counts.0.saturating_add(n as u64); }
+            else { counts.1=counts.1.saturating_add(n as u64); }}
+        self.feed.record_traffic_with(Arc::clone(&self.id),||Some(*self.counts.lock()));
+    }
+}
+impl Drop for InternalRequest {
+    fn drop(&mut self) {
+        let (up,down)=*self.counts.get_mut();
+        self.feed.close_request(&self.id,||json!({"id":self.id,"end":timestamp(),"upload":up.to_string(),"download":down.to_string()}));
+    }
+}
+/// Observes successful I/O at the same layer where the real stream is owned.
+/// A TLS wrapper goes outside this so TLS handshake bytes are not invented.
+pub struct ObservedIo<S> { inner:S, request:Option<InternalRequest> }
+impl<S> ObservedIo<S> { pub fn new(inner:S, request:Option<InternalRequest>)->Self { Self { inner,request } } }
+impl<S:tokio::io::AsyncRead+Unpin> tokio::io::AsyncRead for ObservedIo<S> {
+    fn poll_read(self:std::pin::Pin<&mut Self>,cx:&mut std::task::Context<'_>,buf:&mut tokio::io::ReadBuf<'_>)->std::task::Poll<io::Result<()>> {
+        let this=self.get_mut();let before=buf.filled().len();
+        let result=std::pin::Pin::new(&mut this.inner).poll_read(cx,buf);
+        if let std::task::Poll::Ready(Ok(()))=&result { if let Some(request)=&this.request { request.download(buf.filled().len()-before); } }
+        result
+    }
+}
+impl<S:tokio::io::AsyncWrite+Unpin> tokio::io::AsyncWrite for ObservedIo<S> {
+    fn poll_write(self:std::pin::Pin<&mut Self>,cx:&mut std::task::Context<'_>,buf:&[u8])->std::task::Poll<io::Result<usize>> {
+        let this=self.get_mut();let result=std::pin::Pin::new(&mut this.inner).poll_write(cx,buf);
+        if let std::task::Poll::Ready(Ok(n))=&result { if let Some(request)=&this.request { request.upload(*n); } }result
+    }
+    fn poll_flush(self:std::pin::Pin<&mut Self>,cx:&mut std::task::Context<'_>)->std::task::Poll<io::Result<()>> { std::pin::Pin::new(&mut self.get_mut().inner).poll_flush(cx) }
+    fn poll_shutdown(self:std::pin::Pin<&mut Self>,cx:&mut std::task::Context<'_>)->std::task::Poll<io::Result<()>> { std::pin::Pin::new(&mut self.get_mut().inner).poll_shutdown(cx) }
+}
