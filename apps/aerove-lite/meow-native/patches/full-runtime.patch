+use crate::transport_tasks::{self, TransportScope};
+use std::{future::Future, io, pin::Pin, task::{Context, Poll}};
+use tokio::task::{AbortHandle, JoinError};
+use parking_lot::Mutex;
+
+type PollFuture<T> = Pin<Box<dyn Future<Output = Result<T, JoinError>> + Send + 'static>>;
+
+pub struct ScopedJoin<T> {
+    future: Mutex<PollFuture<T>>,
+    abort: AbortHandle,
+}
+impl<T> ScopedJoin<T> {
+    pub fn abort(&self) { self.abort.abort(); }
+    pub fn abort_handle(&self) -> AbortHandle { self.abort.clone() }
+    pub fn is_finished(&self) -> bool { self.abort.is_finished() }
+}
+impl<T> Future for ScopedJoin<T> {
+    type Output = Result<T, JoinError>;
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        self.get_mut().future.get_mut().as_mut().poll(cx)
+    }
+}
+impl<T: Send + 'static> From<tokio::task::JoinHandle<T>> for ScopedJoin<T> {
+    fn from(handle: tokio::task::JoinHandle<T>) -> Self {
+        let abort = handle.abort_handle();
+        let future: PollFuture<T> = Box::pin(handle);
+        Self { future: Mutex::new(future), abort }
+    }
+}
+#[derive(Clone)]
+pub struct Spawner { scope: Option<TransportScope> }
+impl Spawner {
+    pub fn capture() -> Self { Self { scope: TransportScope::current() } }
+    pub fn try_spawn<F>(&self, work: F) -> io::Result<ScopedJoin<F::Output>>
+    where F: Future + Send + 'static, F::Output: Send + 'static {
+        let (send, receive) = tokio::sync::oneshot::channel();
+        let inherited = self.scope.clone();
+        let diagnostic = transport_tasks::DiagnosticToken::capture();
+        let unit = Box::pin(diagnostic.scope(async move {
+            let value = match inherited { Some(scope) => scope.scope(work).await, None => work.await };
+            let _ = send.send(value);
+        }));
+        let shared = match &self.scope {
+            Some(scope) => scope.spawn_join(unit)?,
+            None => {
+                if TransportScope::current().is_some() { return Err(io::Error::other("capturedTransportOwnerMissing")); }
+                transport_tasks::spawn_join(unit)?
+            }
+        };
+        let abort = shared.abort_handle();
+        let future: PollFuture<F::Output> = Box::pin(async move {
+            shared.join_result().await?;
+            Ok(receive.await.expect("transport owner must poll UnitWork to completion"))
+        });
+        Ok(ScopedJoin { abort, future: Mutex::new(future) })
+    }
+}
+pub fn try_spawn<F>(work: F) -> io::Result<ScopedJoin<F::Output>>
+where F: Future + Send + 'static, F::Output: Send + 'static {
+    Spawner::capture().try_spawn(work)
+}
