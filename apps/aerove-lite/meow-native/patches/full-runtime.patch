+/// Original graph identities and the owner admission ticket for one URL probe.
+/// Capture reserves only an intent; it makes no routing decision, I/O, task or health mutation.
+pub struct UrlDelayReceipt {
+    pub proxy: Arc<dyn Proxy>,
+    pub proxies: Vec<Arc<dyn Proxy>>,
+    pub dependencies: Vec<ProbeDependencies>,
+    pub admission: Option<UrlProbeStamp>,
+}
+impl UrlDelayReceipt {
+    pub fn capture(proxy: &Arc<dyn Proxy>) -> Option<Arc<Self>> {
+        fn visit(proxy: &Arc<dyn Proxy>, depth: usize, active: &mut std::collections::BTreeSet<usize>,
+            seen: &mut std::collections::BTreeSet<usize>, receipt: &mut UrlDelayReceipt) -> Option<()> {
+            if depth > 64 { return None; }
+            let key = Arc::as_ptr(proxy).cast::<()>() as usize;
+            if active.contains(&key) { return None; }
+            if !seen.insert(key) { return Some(()); }
+            active.insert(key);
+            if let Some(members) = proxy.member_proxies() {
+                for member in members { visit(&member, depth + 1, active, seen, receipt)?; }
+            }
+            let proof = proxy.probe_dependencies().ok()?;
+            if !proof.is_current() { return None; }
+            for dependency in &proof.proxies { visit(dependency, depth + 1, active, seen, receipt)?; }
+            receipt.dependencies.push(proof); receipt.proxies.push(proxy.clone());
+            active.remove(&key); Some(())
+        }
+        let mut receipt = Self { proxy: proxy.clone(), proxies: Vec::new(), dependencies: Vec::new(), admission: None };
+        visit(proxy, 0, &mut Default::default(), &mut Default::default(), &mut receipt)?;
+        if !crate::probe_policy::DiagnosticToken::capture().is_measurement() {
+            let observer = proxy.health().observer.read().unwrap_or_else(std::sync::PoisonError::into_inner).clone();
+            receipt.admission = match observer { Some(observer) => observer.begin_url_probe(proxy).ok()?, None => None };
+        }
+        if !receipt.is_current() { return None; }
+        Some(Arc::new(receipt))
+    }
+    pub fn is_current(&self) -> bool { self.dependencies.iter().all(ProbeDependencies::is_current) }
+
+}
