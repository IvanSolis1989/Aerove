+impl ConsumptionTrace {
+    pub fn new(owner: usize, stamp: (u64,u64,u64,u64), intent: u64) -> Arc<Self> {
+        Arc::new(Self { owner, state: std::sync::Mutex::new(ConsumptionTraceState { expected: stamp, intent, validation: None }) })
