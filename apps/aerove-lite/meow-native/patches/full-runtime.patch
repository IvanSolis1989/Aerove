+/// Run one upstream exchange in this resolver generation's captured task
+/// owner. The task owner retains and joins the real spawned task at retirement.
+async fn run_owned_query<T, F>(scope: Option<TransportScope>, future: F) -> Result<T, ClientError>
+where
+    T: Send + 'static,
+    F: Future<Output = Result<T, ClientError>> + Send + 'static,
+{
+    let Some(scope) = scope else {
+        #[cfg(all(
+            feature = "aerove-android-runtime",
+            any(target_os = "linux", target_os = "android", target_os = "macos")
+        ))]
+        if meow_common::socket_protect::NetworkScope::current().is_some() {
+            return Err(ClientError::Io(io::Error::other("capturedTransportOwnerMissing")));
+        }
+        return future.await;
+    };
+    let (tx, rx) = tokio::sync::oneshot::channel();
+    let task_scope = scope.clone();
+    let work: Work = Box::pin(async move {
+        let result = task_scope.scope(future).await;
+        let _ = tx.send(result);
+    });
+    // The HTTPS upstream exchange is spawned here (not by Resolver::spawn_owned).
+    // Capture ECH ancestry explicitly before crossing this real task boundary.
+    #[cfg(feature = "encrypted")]
+    let work: Work = meow_transport::tls::EchScope::wrap_current(work);
+    let abort = scope
+        .scope(async { transport_tasks::spawn(work) })
+        .await
+        .map_err(ClientError::Io)?;
+    struct AbortIfCallerLeaves(Option<tokio::task::AbortHandle>);
+    impl Drop for AbortIfCallerLeaves {
+        fn drop(&mut self) {
+            if let Some(abort) = self.0.take() {
+                abort.abort();
+            }
+        }
+    }
+    let mut abort_if_caller_leaves = AbortIfCallerLeaves(Some(abort));
+    let result = rx
+        .await
+        .map_err(|_| ClientError::Io(io::Error::new(
+            io::ErrorKind::Interrupted,
+            "captured DNS generation retired",
+        )))?;
+    abort_if_caller_leaves.0.take();
+    result
