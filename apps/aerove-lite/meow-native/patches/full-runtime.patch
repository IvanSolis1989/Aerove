+pub(super) fn spawn_owned<F, R>(
+    binding: &crate::provider_events::ProviderBinding,
+    work: F,
+) -> Result<tokio::task::JoinHandle<R>>
+where
+    F: FnOnce() -> R + Send + 'static,
+    R: Send + 'static,
+{
+    let dispatch = tracing::dispatcher::get_default(Clone::clone);
+    let work = move || tracing::dispatcher::with_default(&dispatch, work);
+    let Some(scope) = binding.scope() else {
+        return Ok(crate::owned_load::spawn_blocking(work));
+    };
+    scope.spawn_blocking_owned(work).map_err(anyhow::Error::msg)
+}
+
+#[derive(Clone)]
+pub(super) struct Source {
+    body: Body,
+    modified: Option<SystemTime>,
+}
+
+#[derive(Clone)]
+enum Body {
+    Bytes(Arc<Vec<u8>>),
+    Upstream {
+        file: Arc<parking_lot::Mutex<File>>,
+        length: u64,
+    },
+}
+
+impl Source {
+    pub(super) fn bytes(bytes: Arc<Vec<u8>>) -> Self {
+        Self {
+            body: Body::Bytes(bytes),
+            modified: None,
+        }
+    }
+
+    pub(super) fn open(path: &Path) -> io::Result<Self> {
+        let mut options = OpenOptions::new();
+        options.read(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            options.custom_flags(libc::O_NONBLOCK);
+        }
+        let mut file = options.open(path)?;
+        let metadata = file.metadata()?;
+        if !metadata.is_file() {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "provider source is not a regular file",
+            ));
+        }
+        let modified = metadata.modified().ok();
+        let scope = crate::owned_load::OwnedLoadScope::current();
+        let check = || {
+            if scope.as_ref().is_some_and(|scope| scope.is_cancelled()) {
+                Err(io::Error::other(MrsError::Cancelled))
+            } else {
+                Ok(())
+            }
+        };
+        check()?;
+        let mut prefix = Vec::with_capacity(4);
+        Read::by_ref(&mut file).take(4).read_to_end(&mut prefix)?;
+        check()?;
+        file.seek(SeekFrom::Start(0))?;
+        if prefix == ZSTD_MAGIC {
+            return Ok(Self {
+                body: Body::Upstream {
+                    file: Arc::new(parking_lot::Mutex::new(file)),
+                    length: metadata.len(),
+                },
+                modified,
+            });
+        }
+        let mut bytes = Vec::new();
+        let mut buffer = [0; 64 * 1024];
+        loop {
+            check()?;
+            let count = file.read(&mut buffer)?;
+            check()?;
+            if count == 0 {
+                break;
+            }
+            bytes.extend_from_slice(&buffer[..count]);
+        }
+        Ok(Self {
+            body: Body::Bytes(Arc::new(bytes)),
+            modified,
+        })
+    }
+
+    pub(super) fn modified(&self) -> Option<SystemTime> {
+        self.modified
+    }
+
+    pub(super) fn as_bytes(&self) -> Option<&[u8]> {
+        match &self.body {
+            Body::Bytes(bytes) => Some(bytes),
+            Body::Upstream { .. } => None,
+        }
+    }
+
+    pub(super) fn parse(
+        &self,
+        behavior: RuleSetBehavior,
+        format: Option<RuleSetFormat>,
+        ctx: &ParserContext,
+        strict: bool,
+        binding: &crate::provider_events::ProviderBinding,
+    ) -> Result<ParsedPayload> {
+        match &self.body {
+            Body::Bytes(bytes) => {
+                super::parse_for_provider(bytes, behavior, format, ctx, strict, binding)
+            }
+            Body::Upstream { file, length } => {
+                let mut file = file.lock();
+                file.seek(SeekFrom::Start(0))?;
+                let mut input = Fingerprinted::new(&mut *file, *length)?;
+                let (rules, pages) = build_upstream(&mut input, behavior, strict, binding)?;
+                let consumed = input.consumed;
+                let hash = input.hash.finish();
+                drop(input);
+                let metadata = file.metadata()?;
+                if consumed != *length
+                    || metadata.len() != *length
+                    || metadata.modified().ok() != self.modified
+                {
+                    return Err(anyhow!("providerFileChangedDuringRead"));
+                }
+                Ok((rules, RuleSetFormat::Mrs, pages, hash, None))
+            }
+        }
+    }
+}
+
+struct Fingerprinted<R> {
+    inner: R,
+    hash: DefaultHasher,
+    consumed: u64,
+}
+
+impl<R> Fingerprinted<R> {
+    fn new(inner: R, length: u64) -> io::Result<Self> {
+        let length = usize::try_from(length).map_err(|_| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "provider file length exceeds address space",
+            )
+        })?;
+        let mut hash = DefaultHasher::new();
+        length.hash(&mut hash);
+        Ok(Self {
+            inner,
+            hash,
+            consumed: 0,
+        })
+    }
+}
+
+impl<R: Read> Read for Fingerprinted<R> {
+    fn read(&mut self, output: &mut [u8]) -> io::Result<usize> {
+        let count = self.inner.read(output)?;
+        self.hash.write(&output[..count]);
+        self.consumed += count as u64;
+        Ok(count)
+    }
+}
+
+/// The provider-facing MRS failure, kept typed for callers. `MrsError` already renders its own cause, so no
+/// source is chained and `{:#}` prints the whole message once.
+#[derive(Debug)]
+struct MrsParseError(MrsError);
+
+impl std::fmt::Display for MrsParseError {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(formatter, "mrs parse error: {}", self.0)
+    }
+}
+
+impl std::error::Error for MrsParseError {}
+
+fn mrs_error(error: MrsError) -> anyhow::Error {
+    anyhow::Error::new(MrsParseError(error))
+}
+
+fn build_upstream<R: Read>(
+    source: R,
+    behavior: RuleSetBehavior,
+    strict: bool,
+    binding: &crate::provider_events::ProviderBinding,
+) -> Result<(Box<dyn meow_rules::RuleSet>, Option<Arc<super::RulePages>>)> {
+    let scope = binding.scope();
+    let admission = scope
+        .as_ref()
+        .and_then(|scope| scope.upstream_rule_admission());
+    let stopped = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let stop = stopped.clone();
+    let owner = scope.clone();
+    let limits = MrsReadControl::default();
+    let compressed = admission
+        .as_ref()
+        .map_or(limits.compressed_limit(), |policy| {
+            policy.compressed_limit().min(limits.compressed_limit())
+        });
+    let control = MrsReadControl::new(compressed, limits.expanded_limit(), move || {
+        owner.as_ref().is_some_and(|scope| scope.is_cancelled())
+            || stop.load(std::sync::atomic::Ordering::Acquire)
+    });
+    let control = match &admission {
+        Some(policy) => policy.control(control, behavior),
+        None => control,
+    };
+    control.check().map_err(mrs_error)?;
+    let capture = capture_pages(binding)?;
+    let sink = capture
+        .as_ref()
+        .map(|capture| capture.clone() as Arc<dyn meow_rules::rule_set::AcceptedEntrySink>);
+    let reader =
+        UpstreamRuleSetReader::open_from_reader(source, control.clone()).map_err(mrs_error)?;
+    let expected = match behavior {
+        RuleSetBehavior::Domain => meow_rules::mrs_parser::TYPE_DOMAIN,
+        RuleSetBehavior::IpCidr => meow_rules::mrs_parser::TYPE_IPCIDR,
+        RuleSetBehavior::Classical => meow_rules::mrs_parser::TYPE_CLASSICAL,
+    };
+    if reader.behavior() == expected {
+        if let Some(policy) = admission {
+            let admitted = policy.validate(&reader, &stopped);
+            if scope.as_ref().is_some_and(|scope| scope.is_cancelled()) {
+                return Err(mrs_error(MrsError::Cancelled));
+            }
+            admitted.map_err(anyhow::Error::msg)?;
+        }
+    }
+    let rules = meow_rules::rule_set::build_rule_set_from_upstream_reader(
+        reader,
+        Some(behavior),
+        strict,
+        sink,
+    )
+    .map_err(mrs_error)?;
+    control.check().map_err(mrs_error)?;
+    let pages = capture
+        .map(|capture| capture.finish(rules.len()))
+        .transpose()
+        .map_err(anyhow::Error::msg)?;
+    control.check().map_err(mrs_error)?;
+    Ok((rules, pages))
+}
+
+pub(super) fn parse_upstream<R: Read>(
+    source: R,
+    behavior: RuleSetBehavior,
+    strict: bool,
+    binding: &crate::provider_events::ProviderBinding,
+    hash: u64,
+) -> Result<ParsedPayload> {
+    let (rules, pages) = build_upstream(source, behavior, strict, binding)?;
+    Ok((rules, RuleSetFormat::Mrs, pages, hash, None))
+}
