+    #[test]
+    fn streamed_owned_actual_256m_fences_use_streams_not_binary_fixtures() {
+        // Byte-fence tests, not an assertion that a zero payload is a valid rule set.
+        let control = MrsReadControl::default();
+        let exceeded = std::cell::Cell::new(false);
+        let mut source = ControlledInput {
+            source: std::io::repeat(0).take(MAX_DECOMPRESSED_BYTES),
+            consumed: 0,
+            control: &control,
+            exceeded: &exceeded,
+        };
+        let mut buffer = [0u8; 64 * 1024];
+        let mut bytes = 0u64;
+        loop {
+            let read = source.read(&mut buffer).unwrap();
+            if read == 0 {
+                break;
+            }
+            bytes += read as u64;
+        }
+        assert_eq!(bytes, MAX_DECOMPRESSED_BYTES);
+        assert!(!exceeded.get());
+        let mut source = ControlledInput {
+            source: std::io::repeat(0).take(MAX_DECOMPRESSED_BYTES + 1),
+            consumed: 0,
+            control: &control,
+            exceeded: &exceeded,
+        };
+        loop {
+            match source.read(&mut buffer) {
+                Ok(0) => panic!("oversized compressed source accepted"),
+                Ok(_) => {}
+                Err(_) => break,
+            }
+        }
+        assert!(exceeded.get());
+        assert_eq!(source.consumed, MAX_DECOMPRESSED_BYTES + 1);
+        assert!(source.read(&mut buffer).is_err());
+        assert_eq!(source.consumed, MAX_DECOMPRESSED_BYTES + 1);
+        let compressed =
+            zstd::encode_all(std::io::repeat(0).take(MAX_DECOMPRESSED_BYTES), 0).unwrap();
+        let expanded = decompress_from_reader(Cursor::new(compressed), &control).unwrap();
+        assert_eq!(expanded.len() as u64, MAX_DECOMPRESSED_BYTES);
+        assert_eq!(expanded.first(), Some(&0));
+        assert_eq!(expanded.last(), Some(&0));
+        drop(expanded);
+        let compressed =
+            zstd::encode_all(std::io::repeat(0).take(MAX_DECOMPRESSED_BYTES + 1), 0).unwrap();
+        assert!(matches!(
+            decompress_from_reader(Cursor::new(compressed), &control)
+                .err()
+                .unwrap(),
+            MrsError::InvalidLength("decompressed_payload", _)
+        ));
+    }
