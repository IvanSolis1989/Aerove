+trait BitWords {
+    fn len(&self) -> usize;
+    fn word(&self, index: usize) -> Option<u64>;
+}
+impl BitWords for [u64] {
+    fn len(&self) -> usize {
+        <[u64]>::len(self)
+    }
+    fn word(&self, index: usize) -> Option<u64> {
+        self.get(index).copied()
+    }
+}
+impl BitWords for Vec<u64> {
+    fn len(&self) -> usize {
+        Vec::len(self)
+    }
+    fn word(&self, index: usize) -> Option<u64> {
+        self.get(index).copied()
+    }
+}
+enum DomainWords<'a> {
+    Owned(Vec<u64>),
+    Borrowed(&'a [u8]),
+}
+impl BitWords for DomainWords<'_> {
+    fn len(&self) -> usize {
+        match self {
+            Self::Owned(words) => words.len(),
+            Self::Borrowed(bytes) => bytes.len() / 8,
+        }
+    }
+    fn word(&self, index: usize) -> Option<u64> {
+        match self {
+            Self::Owned(words) => words.get(index).copied(),
+            Self::Borrowed(bytes) => {
+                let offset = index.checked_mul(8)?;
+                Some(u64::from_be_bytes(
+                    bytes.get(offset..offset.checked_add(8)?)?.try_into().ok()?,
+                ))
+            }
+        }
+    }
+}
+fn read_domain_words<'a>(
+    reader: &mut ByteReader<'a>,
+    what: &'static str,
+    control: Option<&MrsReadControl>,
+    borrowed: bool,
+) -> Result<DomainWords<'a>, MrsError> {
+    if !borrowed {
+        return read_u64_vec_controlled(reader, what, control).map(DomainWords::Owned);
+    }
+    checkpoint(control)?;
+    let declared = reader.read_i64_be(what)?;
+    if declared < 1 {
+        return Err(MrsError::InvalidLength(what, declared));
+    }
+    let words = usize::try_from(declared).map_err(|_| MrsError::InvalidLength(what, declared))?;
+    let bytes = words
+        .checked_mul(8)
+        .ok_or(MrsError::InvalidLength(what, declared))?;
+    let view = reader.read_slice(what, bytes)?;
+    checkpoint(control)?;
+    Ok(DomainWords::Borrowed(view))
+}
