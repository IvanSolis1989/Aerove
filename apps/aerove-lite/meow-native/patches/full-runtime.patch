+    pub fn traffic_class(&self) -> TrafficClass {
+        match self.leaf_type { AdapterType::Direct => TrafficClass::Direct,
+            AdapterType::Reject | AdapterType::RejectDrop | AdapterType::Pass | AdapterType::PassRule => TrafficClass::Uncounted,
+            _ => TrafficClass::Proxy }
+    }
+}
+#[derive(Default, Debug)]
+pub struct DialReceipt(Mutex<Option<(DialOutcome, bool)>>);
+impl DialReceipt {
+    pub fn outcome(&self) -> Option<DialOutcome> { self.0.lock().unwrap().as_ref().map(|(outcome,_)|outcome.clone()) }
+    fn completed_route(&self) -> Option<DialOutcome> { self.0.lock().unwrap().as_ref().and_then(|entry| if entry.1 { Some(entry.0.clone()) } else { None }) }
+    pub fn complete(&self, outcome: DialOutcome) -> Result<()> { self.finish(outcome,false) }
+    /// A complete semantic route, not an incidental lower transport dial.
+    pub fn complete_route(&self, outcome: DialOutcome) -> Result<()> { self.finish(outcome,true) }
+    fn finish(&self, outcome: DialOutcome, route: bool) -> Result<()> {
+        let mut slot=self.0.lock().unwrap();
+        if slot.is_some() { return Err(MeowError::Proxy("dial receipt already completed".into())); }
+        *slot=Some((outcome,route)); Ok(())
+    }
+    pub fn branch(metadata: &Metadata) -> (Metadata, Arc<Self>) {
+        let receipt=Arc::new(Self::default()); let mut child=metadata.clone(); child.dial_receipt=Some(receipt.clone()); (child,receipt)
+    }
+    pub fn commit(metadata: &Metadata, kind: AdapterType, name: &str, child: &Self) -> Result<()> {
+        // Raw REJECT transports deliberately implement EOF/discard (DROP waits).
+        // Returning such a transport is not a successful forwarding dial, even
+        // when the caller did not request a receipt. Preserve raw behavior and
+        // reject only after the raw dial has resolved, so DROP stays cancellable.
+        if matches!(kind,AdapterType::Reject|AdapterType::RejectDrop|AdapterType::Pass|AdapterType::PassRule) {
+            return Err(MeowError::Proxy("rejected".into()));
+        }
+        let Some(parent)=metadata.dial_receipt.as_ref() else { return Ok(()); };
+        let group=matches!(kind,AdapterType::Selector|AdapterType::Fallback|AdapterType::UrlTest|AdapterType::LoadBalance|AdapterType::Relay);
+        let mut outcome=if group { child.outcome().ok_or_else(||MeowError::Proxy("successful group dial omitted leaf outcome".into()))? }
+            else { child.completed_route().unwrap_or_else(|| DialOutcome { leaf_type:kind, chains:vec![Arc::from(name)] }) };
+        if group && outcome.chains.last().is_none_or(|entry| entry.as_ref()!=name) { outcome.chains.push(Arc::from(name)); }
+        if group || child.completed_route().is_some() { parent.complete_route(outcome) } else { parent.complete(outcome) }
+    }
+}
