+        loop {
+            let length = left.read(&mut a).map_err(|error| format!("rulePageStorage: {error}"))?;
+            if length == 0 { return Ok(right.read(&mut b[..1]).map_err(|error| format!("rulePageStorage: {error}"))? == 0); }
