+use crate::owned_load::{LoadContext, OwnedLoadScope, OwnedWork};
+use std::sync::Arc;
+
+struct OfflineContext;
+impl LoadContext for OfflineContext {
+    fn offline_validation(&self) -> bool { true }
+    fn wrap(&self, work: OwnedWork) -> OwnedWork { work }
+    fn run_blocking(&self, work: Box<dyn FnOnce() + Send>) { work(); }
+}
+struct CancelOnDrop(Arc<OwnedLoadScope>);
+impl Drop for CancelOnDrop { fn drop(&mut self) { self.0.cancel(); } }
+
+/// Run the real fixed-core converter in a private captured offline scope.
+/// No process-global offline/plugin policy is written and no core is started.
+pub async fn validate_offline_config(source: &str) -> Result<(), String> {
+    let scope = OwnedLoadScope::with_context(Arc::new(OfflineContext));
+    validate_offline_config_with_scope(source, &scope).await
+}
+
+/// Cancellation-aware embedding/testing entry. The caller can retain this same
+/// scope and await close even after dropping the validation request future.
+pub async fn validate_offline_config_with_scope(source: &str, scope: &Arc<OwnedLoadScope>) -> Result<(), String> {
+    if !scope.offline_validation() { return Err("offline_scope_required".into()); }
+    let _cancel = CancelOnDrop(scope.clone());
+    let result = scope.run(async {
+        tokio::select! {
+            biased;
+            _ = scope.cancelled() => Err("offline_validation_cancelled".into()),
+            result = async {
+                let mut raw = crate::parse_raw_yaml(source).map_err(|error| error.to_string())?;
+                let mut input: serde_yaml::Value = serde_yaml::from_str(source).map_err(|error| error.to_string())?;
+                input.apply_merge().map_err(|error| error.to_string())?;
+                let typed = serde_yaml::to_value(&raw).map_err(|error| error.to_string())?;
+                require_preserved_keys(&input, &typed, "$")?;
+                // Validation cannot succeed after the lenient converter drops a
+                // malformed proxy/rule or falls back to a different enum value.
+                raw.strict = Some(true);
+                for proxy in raw.proxies.iter().flatten() {
+                    if crate::proxy_parser::node_selects_external_plugin(proxy) {
+                        return Err("offline_external_plugin_forbidden".to_owned());
+                    }
+                }
+                // No trusted resource lease is supplied to this string-only
+                // entry. Do not validate against an ambient user's geodata or
+                // invent empty country/category DBs and report conversion success.
+                let scan = crate::collect_geo_scan_lines(&raw, &crate::rule_provider::PrefetchedPayloads::default());
+                if scan.iter().any(|line| crate::line_references_geoip(line) || crate::line_references_asn(line) || crate::line_references_geosite(line)) || crate::dns_policy_uses_geosite(&raw) {
+                    return Err("offline_geodata_resource_context_required".to_owned());
+                }
+                let config = crate::build_config(raw, None).await.map_err(|error| error.to_string())?;
+                drop(config);
+                Ok(())
+            } => result,
+        }
+    }).await;
+    scope.close().await.map_err(str::to_owned)?;
+    result
+}
+
+// Compare the official typed schema instead of maintaining another key list.
+// Dynamic proxy maps remain subject to the embedding boundary's protocol guards.
+fn require_preserved_keys(input: &serde_yaml::Value, typed: &serde_yaml::Value, path: &str) -> Result<(), String> {
+    match (input, typed) {
+        (serde_yaml::Value::Mapping(input), serde_yaml::Value::Mapping(typed)) => {
+            for (key, value) in input {
+                let name = key.as_str().ok_or_else(|| format!("{path}: non_string_key"))?;
+                let path = format!("{path}.{name}");
+                let converted = typed.get(key).ok_or_else(|| format!("{path}: unsupported_config_field"))?;
+                require_preserved_keys(value, converted, &path)?;
+            }
+        }
+        (serde_yaml::Value::Sequence(input), serde_yaml::Value::Sequence(typed)) => {
+            for (index, value) in input.iter().enumerate() {
+                let converted = typed.get(index).ok_or_else(|| format!("{path}[{index}]: dropped_config_entry"))?;
+                require_preserved_keys(value, converted, &format!("{path}[{index}]"))?;
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
