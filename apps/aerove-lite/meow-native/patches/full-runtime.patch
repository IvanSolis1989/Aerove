+#[cfg(test)]
+mod host_admission_index_tests {
+    use super::*;
+    use std::sync::{
+        atomic::{AtomicBool, Ordering},
+        Arc,
+    };
+    struct Policy {
+        slots: usize,
+        reject: bool,
+    }
+    impl MrsHostAdmission for Policy {
+        fn header(&self, _behavior: u8, _count: u64) -> Result<(), String> {
+            if self.reject {
+                Err("host header count limit".into())
+            } else {
+                Ok(())
+            }
+        }
+        fn index_slots(&self) -> usize {
+            self.slots
+        }
+    }
+    #[test]
+    fn host_header_rejects_before_the_expanded_tail_budget() {
+        let mut payload = Vec::new();
+        payload.extend_from_slice(&UPSTREAM_MRS_MAGIC);
+        payload.push(TYPE_DOMAIN);
+        payload.extend_from_slice(&250001i64.to_be_bytes());
+        payload.resize(1024 * 1024, 0);
+        let bytes = zstd::encode_all(Cursor::new(payload), 0).unwrap();
+        let default = MrsReadControl::new(1024 * 1024, 64, || false);
+        assert!(matches!(
+            decompress_from_reader(Cursor::new(&bytes), &default),
+            Err(MrsError::InvalidLength("decompressed_payload", 64))
+        ));
+        let host = default.with_host_admission(Arc::new(Policy {
+            slots: 3,
+            reject: true,
+        }));
+        assert!(
+            matches!(decompress_from_reader(Cursor::new(&bytes), &host), Err(MrsError::RuleSet(reason)) if reason == "host header count limit")
+        );
+        struct CancelHeader(Arc<AtomicBool>);
+        impl MrsHostAdmission for CancelHeader {
+            fn header(&self, _: u8, _: u64) -> Result<(), String> {
+                self.0.store(true, Ordering::Release);
+                Err("count limit".into())
+            }
+            fn index_slots(&self) -> usize {
+                1
+            }
+        }
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let flag = cancelled.clone();
+        let control = MrsReadControl::new(1024 * 1024, 64, move || flag.load(Ordering::Acquire))
+            .with_host_admission(Arc::new(CancelHeader(cancelled)));
+        assert!(matches!(
+            decompress_from_reader(Cursor::new(&bytes), &control),
+            Err(MrsError::Cancelled)
+        ));
+    }
+    #[test]
+    fn borrowed_tables_and_sampled_queries_match_every_dense_result() {
+        let mut words = vec![0u64; 128];
+        for index in 0..words.len() {
+            if index % 11 == 0 {
+                words[index] = 0x8124800100000021;
+            }
+        }
+        let count = words.iter().map(|word| word.count_ones() as usize).sum();
+        let mut bytes = (words.len() as i64).to_be_bytes().to_vec();
+        for word in &words {
+            bytes.extend_from_slice(&word.to_be_bytes());
+        }
+        let view =
+            read_domain_words(&mut ByteReader::new(&bytes), "host words", None, true).unwrap();
+        assert!(
+            matches!(&view, DomainWords::Borrowed(data) if data.as_ptr() == bytes[8..].as_ptr())
+        );
+        let host = MrsReadControl::default().with_host_admission(Arc::new(Policy {
+            slots: 3,
+            reject: false,
+        }));
+        let sparse = DomainSetIndex::new_controlled(&view, Some(&host), Some(count)).unwrap();
+        let dense = DomainSetIndex::new_controlled(&words, None, Some(count)).unwrap();
+        assert!(sparse.rank_ones_by_word.len() <= 4);
+        assert!(sparse.select_ones.len() <= 3);
+        for upto in 0..=words.len() * 64 + 1 {
+            assert_eq!(
+                sparse.count_zeros(&view, upto, Some(&host)).unwrap(),
+                dense.count_zeros(&words, upto, None).unwrap()
+            );
+        }
+        for nth in 0..=count + 1 {
+            assert_eq!(
+                sparse.select_one(&view, nth, Some(&host)).unwrap(),
+                dense.select_one(&words, nth, None).unwrap()
+            );
+        }
+        let cancelled = Arc::new(AtomicBool::new(false));
+        let flag = cancelled.clone();
+        let control =
+            MrsReadControl::new(MAX_DECOMPRESSED_BYTES, MAX_DECOMPRESSED_BYTES, move || {
+                flag.load(Ordering::Acquire)
+            })
+            .with_host_admission(Arc::new(Policy {
+                slots: 1,
+                reject: false,
+            }));
+        let index = DomainSetIndex::new_controlled(&view, Some(&control), Some(count)).unwrap();
+        cancelled.store(true, Ordering::Release);
+        assert!(matches!(
+            index.count_zeros(&view, 64 * 64, Some(&control)),
+            Err(MrsError::Cancelled)
+        ));
+        assert!(matches!(
+            index.select_one(&view, 1, Some(&control)),
+            Err(MrsError::Cancelled)
+        ));
+    }
+}
