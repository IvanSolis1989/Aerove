+use std::{fs::{File, OpenOptions}, io::{BufWriter, Read, Seek, SeekFrom, Write}, path::{Path, PathBuf}, sync::Arc};
+use parking_lot::Mutex;
+use meow_rules::rule_set::AcceptedEntrySink;
+
+/// The matcher builders emit accepted entries once into bounded buffered storage.
+/// The offset index lives on disk, avoiding a permanent second Vec<String> for MRS.
+pub struct PageCapture {
+    state: Mutex<CaptureState>,
+}
+struct CaptureState {
+    data: Option<BufWriter<File>>,
+    index: Option<BufWriter<File>>,
+    paths: Option<[PathBuf; 2]>,
+    count: usize,
+    bytes: u64,
+    error: Option<String>,
+}
+pub struct RulePages {
+    files: Mutex<Option<(File, File)>>,
+    paths: [PathBuf; 2],
+    count: usize,
+}
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RulePage {
+    pub rules: Vec<String>, pub rule_count: usize, pub offset: usize,
+    pub next_offset: Option<usize>, pub complete: bool,
+}
+impl PageCapture {
+    pub fn create(root: &Path) -> Result<Arc<Self>, String> {
+        let directory = crate::safe_path::resolve_contained_strict(root, Path::new("rule-pages"))?;
+        std::fs::create_dir_all(&directory).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let data_path = crate::unique_scratch_path(&directory.join("entries"));
+        let mut index_name = data_path.as_os_str().to_os_string(); index_name.push(".index");
+        let index_path = PathBuf::from(index_name);
+        let data = OpenOptions::new().read(true).write(true).create_new(true).open(&data_path)
+            .map_err(|error| format!("rulePageStorage: {error}"))?;
+        let index = match OpenOptions::new().read(true).write(true).create_new(true).open(&index_path) {
+            Ok(index) => index,
+            Err(error) => { drop(data); let _ = std::fs::remove_file(&data_path); return Err(format!("rulePageStorage: {error}")); }
+        };
+        Ok(Arc::new(Self { state: Mutex::new(CaptureState {
+            data: Some(BufWriter::with_capacity(32 * 1024, data)), index: Some(BufWriter::with_capacity(16 * 1024, index)),
+            paths: Some([data_path, index_path]), count: 0, bytes: 0, error: None,
+        }) }))
+    }
+    pub fn finish(&self, expected: usize) -> Result<Arc<RulePages>, String> {
+        let mut state = self.state.lock();
+        if let Some(error) = &state.error { return Err(error.clone()); }
+        if state.count != expected { return Err("rulePageBuilderCountMismatch".into()); }
+        let mut data = state.data.take().ok_or("rulePageStorageAlreadyFinished")?;
+        let mut index = state.index.take().ok_or("rulePageStorageAlreadyFinished")?;
+        data.flush().and_then(|()| index.flush()).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let data = data.into_inner().map_err(|error| format!("rulePageStorage: {error}"))?;
+        let index = index.into_inner().map_err(|error| format!("rulePageStorage: {error}"))?;
+        let paths = state.paths.take().ok_or("rulePageStorageAlreadyFinished")?;
+        Ok(Arc::new(RulePages { files: Mutex::new(Some((data, index))), paths, count: state.count }))
+    }
+}
+impl AcceptedEntrySink for PageCapture {
+    fn accepted(&self, entry: &str) {
