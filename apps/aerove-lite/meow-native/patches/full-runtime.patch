+#[tokio::test]
+async fn reader15_scope_cancel_is_typed_and_real_blocking_worker_lease_is_joined() {
+    struct Gate {
+        inner: Cursor<&'static [u8]>,
+        entered: Option<std::sync::mpsc::Sender<()>>,
+        release: std::sync::mpsc::Receiver<()>,
+    }
+    impl Read for Gate {
+        fn read(&mut self, bytes: &mut [u8]) -> io::Result<usize> {
+            if let Some(entered) = self.entered.take() {
+                entered.send(()).unwrap();
+                self.release.recv().unwrap();
+            }
+            self.inner.read(bytes)
+        }
+    }
+    let scope = OwnedLoadScope::new();
+    let binding = scope.run(async { binding() }).await;
+    let operation = binding.begin().unwrap();
+    let weak = Arc::downgrade(&operation);
+    let (entered, seen) = std::sync::mpsc::channel();
+    let (release, wait) = std::sync::mpsc::channel();
+    let captured = binding.clone();
+    let worker = spawn_owned(&binding, move || {
+        let _operation = operation;
+        parse_upstream(
+            Gate {
+                inner: Cursor::new(DOMAIN),
+                entered: Some(entered),
+                release: wait,
+            },
+            RuleSetBehavior::Domain,
+            true,
+            &captured,
+            provider::hash_payload(DOMAIN),
+        )
+    })
+    .unwrap();
+    tokio::task::spawn_blocking(move || seen.recv_timeout(Duration::from_secs(5)).unwrap())
+        .await
+        .unwrap();
+    scope.cancel();
+    assert!(
+        tokio::time::timeout(Duration::from_millis(25), scope.close())
+            .await
+            .is_err()
+    );
+    assert!(
+        weak.upgrade().is_some(),
+        "operation lease is still held by the actual read"
+    );
+    release.send(()).unwrap();
+    let error = worker.await.unwrap().err().unwrap();
+    assert!(matches!(mrs(&error), Some(MrsError::Cancelled)));
+    scope.close().await.unwrap();
+    assert!(weak.upgrade().is_none());
+}
