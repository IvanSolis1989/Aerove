+/// Read-only substitutions for the exact provider slots a factory will install.
+/// Values retain original Arc order and identity; no slot is published here.
+#[derive(Clone, Default)]
+pub struct ProviderSlotProjection { slots: Vec<ProjectedProviderSlot> }
+#[derive(Clone)]
