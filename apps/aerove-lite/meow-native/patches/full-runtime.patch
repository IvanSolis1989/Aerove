+#[derive(Default)]
+struct Owner(Mutex<Vec<Arc<SharedUnitJoin>>>);
+impl TransportTaskContext for Owner {
+    fn spawn(&self, work: Work) -> io::Result<AbortHandle> {
+        self.spawn_join(work).map(|record| record.abort_handle())
+    }
+    fn spawn_join(&self, work: Work) -> io::Result<Arc<SharedUnitJoin>> {
+        let record = SharedUnitJoin::new(tokio::spawn(work));
+        self.0.lock().push(record.clone());
+        Ok(record)
+    }
+}
