+/// Captured ownership context only; never reads or changes the CLI global.
+pub fn offline_validation() -> bool { OwnedLoadScope::current().is_some_and(|scope| scope.offline_validation()) }
+
+/// An explicit fresh DNS-generation owner overrides the initial factory owner.
+/// Only this future sees it; no global or successor context is consulted.
+pub fn with_dns_transport_scope<'a, F>(scope: meow_common::transport_tasks::TransportScope, work: F)
+    -> Pin<Box<dyn Future<Output = F::Output> + Send + 'a>>
+where F: Future + Send + 'a, F::Output: Send + 'a {
+    let work: Pin<Box<dyn Future<Output = F::Output> + Send + 'a>> = Box::pin(work);
+    Box::pin(DNS_TRANSPORT.scope(scope, work))
+}
+
+pub(crate) fn dns_transport_scope() -> Result<Option<meow_common::transport_tasks::TransportScope>, &'static str> {
+    let owner = OwnedLoadScope::current();
+    if owner.as_ref().is_some_and(|owner| owner.is_cancelled()) { return Err("ownedLoadScopeClosed"); }
+    if let Ok(scope) = DNS_TRANSPORT.try_with(Clone::clone) { return Ok(Some(scope)); }
+    let Some(owner) = owner else { return Ok(None); };
+    let scope = owner.context.dns_transport_scope();
+    if scope.is_none() && owner.context.requires_dns_transport_scope() { return Err("dnsTransportOwnerMissing"); }
+    Ok(scope)
+}
