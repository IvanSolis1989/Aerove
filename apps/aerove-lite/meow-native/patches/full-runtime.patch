+        fn poll_read(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &mut tokio::io::ReadBuf<'_>) -> Poll<std::io::Result<()>> {
+            Pin::new(&mut self.inner).poll_read(cx, buf)
+        }
+    }
+    impl<R> Drop for Reader<R> { fn drop(&mut self) { self.dropped.fetch_add(1, Ordering::SeqCst); } }
+    struct Writer<W> { inner: W, dropped: Arc<AtomicUsize> }
+    impl<W: AsyncWrite + Unpin> AsyncWrite for Writer<W> {
+        fn poll_write(mut self: Pin<&mut Self>, cx: &mut Context<'_>, buf: &[u8]) -> Poll<std::io::Result<usize>> { Pin::new(&mut self.inner).poll_write(cx, buf) }
+        fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> { Pin::new(&mut self.inner).poll_flush(cx) }
+        fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<std::io::Result<()>> { Pin::new(&mut self.inner).poll_shutdown(cx) }
+    }
+    impl<W> Drop for Writer<W> { fn drop(&mut self) { self.dropped.fetch_add(1, Ordering::SeqCst); } }
+    async fn pooled() -> (Arc<Session>, Arc<SessionPool>, tokio::net::TcpStream, Arc<AtomicUsize>) {
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let connection = tokio::net::TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+        let (peer, _) = listener.accept().await.unwrap();
+        let (reader, writer) = connection.into_split();
+        let dropped = Arc::new(AtomicUsize::new(0));
+        let session = Arc::new(Session::new_client(Reader { inner: reader, dropped: dropped.clone() },
+            Writer { inner: writer, dropped: dropped.clone() }, PaddingFactory::default().into_shared(), None));
+        session.set_seq(1);
+        let pool = Arc::new(SessionPool::new());
+        pool.stop_cleanup_task().await;
+        pool.add_idle_session(session.clone()).await;
+        assert_eq!(pool.idle_count().await, 1);
+        (session, pool, peer, dropped)
