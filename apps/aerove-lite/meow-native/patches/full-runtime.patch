+        let invalid_label = {
+            let mut reader = ByteReader::new(&mixed);
+            assert_eq!(reader.read_u8("version").unwrap(), 1);
+            read_u64_vec(&mut reader, "leaves").unwrap();
+            read_u64_vec(&mut reader, "bitmap").unwrap();
+            let labels_len = reader.read_i64_be("labels_len").unwrap() as usize;
+            let labels_offset = mixed.len() - reader.remaining_slice().len();
+            labels_offset
+                + mixed[labels_offset..labels_offset + labels_len]
+                    .iter()
+                    .position(|byte| *byte == b'b')
+                    .unwrap()
+        };
+        mixed[invalid_label] = 0xff;
