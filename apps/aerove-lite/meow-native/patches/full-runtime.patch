+        assert!(Arc::ptr_eq(a.value.as_ref().unwrap(),b.value.as_ref().unwrap()));
+        lease.pending.push_back(a);second.pending.push_back(b);
+        for expected in [32,32,1] {
+            let a=parse(lease.next_frame().await.unwrap());
+            let b=parse(second.next_frame().await.unwrap());
+            assert_eq!(a["events"],b["events"]);
+            assert_eq!(a["events"].as_array().unwrap().len(),expected);
+            assert_eq!(feed.event_encodes.load(std::sync::atomic::Ordering::Relaxed),encoded);
+        }
+        drop(second);
+
+    }
+}
