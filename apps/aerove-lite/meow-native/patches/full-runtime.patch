+/// The matcher builders emit accepted entries once into bounded buffered storage.
+/// The offset index lives on disk, avoiding a permanent second Vec<String> for MRS.
+pub struct PageCapture {
+    state: Mutex<CaptureState>,
+}
+struct CaptureState {
+    data: Option<BufWriter<File>>,
+    index: Option<BufWriter<File>>,
+    paths: Option<[PathBuf; 2]>,
+    count: usize,
+    bytes: u64,
+    error: Option<String>,
+}
+pub struct RulePages {
+    files: Mutex<Option<(File, File)>>,
+    paths: [PathBuf; 2],
+    count: usize,
+}
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct RulePage {
+    pub rules: Vec<String>, pub rule_count: usize, pub offset: usize,
+    pub next_offset: Option<usize>, pub complete: bool,
+}
+impl PageCapture {
+    pub fn create(root: &Path) -> Result<Arc<Self>, String> {
+        let directory = crate::safe_path::resolve_contained_strict(root, Path::new("rule-pages"))?;
+        std::fs::create_dir_all(&directory).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let data_path = crate::unique_scratch_path(&directory.join("entries"));
+        let mut index_name = data_path.as_os_str().to_os_string(); index_name.push(".index");
+        let index_path = PathBuf::from(index_name);
+        let data = OpenOptions::new().read(true).write(true).create_new(true).open(&data_path)
+            .map_err(|error| format!("rulePageStorage: {error}"))?;
+        let index = match OpenOptions::new().read(true).write(true).create_new(true).open(&index_path) {
+            Ok(index) => index,
+            Err(error) => { drop(data); let _ = std::fs::remove_file(&data_path); return Err(format!("rulePageStorage: {error}")); }
+        };
+        Ok(Arc::new(Self { state: Mutex::new(CaptureState {
+            data: Some(BufWriter::with_capacity(32 * 1024, data)), index: Some(BufWriter::with_capacity(16 * 1024, index)),
+            paths: Some([data_path, index_path]), count: 0, bytes: 0, error: None,
+        }) }))
+    }
+    pub fn finish(&self, expected: usize) -> Result<Arc<RulePages>, String> {
+        let mut state = self.state.lock();
+        if let Some(error) = &state.error { return Err(error.clone()); }
+        if state.count != expected { return Err("rulePageBuilderCountMismatch".into()); }
+        let mut data = state.data.take().ok_or("rulePageStorageAlreadyFinished")?;
+        let mut index = state.index.take().ok_or("rulePageStorageAlreadyFinished")?;
+        data.flush().and_then(|()| index.flush()).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let data = data.into_inner().map_err(|error| format!("rulePageStorage: {error}"))?;
+        let index = index.into_inner().map_err(|error| format!("rulePageStorage: {error}"))?;
+        let paths = state.paths.take().ok_or("rulePageStorageAlreadyFinished")?;
+        Ok(Arc::new(RulePages { files: Mutex::new(Some((data, index))), paths, count: state.count }))
+    }
+}
+impl AcceptedEntrySink for PageCapture {
+    fn accepted(&self, entry: &str) {
+        let mut state = self.state.lock();
+        if state.error.is_some() { return; }
+        let result = (|| -> Result<(), String> {
+            let length = u32::try_from(entry.len()).map_err(|_| "rulePageEntryTooLarge")?;
+            let count = state.count.checked_add(1).filter(|count| *count <= i32::MAX as usize).ok_or("rulePageCountExceeded")?;
+            let offset = state.bytes;
+            let next = offset.checked_add(4).and_then(|offset| offset.checked_add(u64::from(length))).ok_or("rulePageStorageTooLarge")?;
+            let data = state.data.as_mut().ok_or("rulePageStorageAlreadyFinished")?;
+            data.write_all(&length.to_le_bytes()).and_then(|()| data.write_all(entry.as_bytes())).map_err(|error| format!("rulePageStorage: {error}"))?;
+            state.index.as_mut().ok_or("rulePageStorageAlreadyFinished")?.write_all(&offset.to_le_bytes()).map_err(|error| format!("rulePageStorage: {error}"))?;
+            state.count = count; state.bytes = next;
+            Ok(())
+        })();
+        if let Err(error) = result { state.error = Some(error); }
+    }
+}
+impl RulePages {
+    pub fn count(&self) -> usize { self.count }
+    /// Compare the exact accepted stream with bounded buffers, outside commit.
+    pub fn same_entries(&self, other: &Self) -> Result<bool, String> {
+        if std::ptr::eq(self, other) { return Ok(true); }
+        if self.count != other.count { return Ok(false); }
+        // Both candidates are immutable. Independent handles avoid locking a
+        // live page reader or acquiring two RulePages locks in reverse order.
+        let mut left = File::open(&self.paths[0]).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let mut right = File::open(&other.paths[0]).map_err(|error| format!("rulePageStorage: {error}"))?;
+        let mut a = [0; 16384]; let mut b = [0; 16384];
+        loop {
+            let length = left.read(&mut a).map_err(|error| format!("rulePageStorage: {error}"))?;
+            if length == 0 { return Ok(right.read(&mut b[..1]).map_err(|error| format!("rulePageStorage: {error}"))? == 0); }
+            if let Err(error) = right.read_exact(&mut b[..length]) {
+                if error.kind() == std::io::ErrorKind::UnexpectedEof { return Ok(false); }
+                return Err(format!("rulePageStorage: {error}"));
+            }
+            if a[..length] != b[..length] { return Ok(false); }
+        }
+    }
+    pub fn page(&self, offset: usize, limit: usize) -> Result<RulePage, String> {
+        if limit == 0 || limit > 10000 { return Err("invalidRulePageLimit".into()); }
+        let mut rows = Vec::new();
+        let mut files = self.files.lock();
+        let (data, index) = files.as_mut().ok_or("rulePageStorageClosed")?;
+        let end = offset.saturating_add(limit).min(self.count);
+        if offset < self.count {
+            let position = u64::try_from(offset).ok().and_then(|offset| offset.checked_mul(8)).ok_or("invalidRulePageOffset")?;
+            index.seek(SeekFrom::Start(position)).map_err(|error| format!("rulePageStorage: {error}"))?;
+            rows.reserve(end - offset);
+            for _ in offset..end {
+                let mut raw = [0; 8]; index.read_exact(&mut raw).map_err(|error| format!("rulePageStorage: {error}"))?;
+                data.seek(SeekFrom::Start(u64::from_le_bytes(raw))).map_err(|error| format!("rulePageStorage: {error}"))?;
+                let mut length = [0; 4]; data.read_exact(&mut length).map_err(|error| format!("rulePageStorage: {error}"))?;
+                let mut bytes = vec![0; u32::from_le_bytes(length) as usize];
+                data.read_exact(&mut bytes).map_err(|error| format!("rulePageStorage: {error}"))?;
+                rows.push(String::from_utf8(bytes).map_err(|_| "rulePageStorageInvalidUtf8")?);
+            }
+        }
+        let complete = offset >= self.count || end >= self.count;
+        Ok(RulePage { rules: rows, rule_count: self.count, offset, next_offset: (!complete).then_some(end), complete })
+    }
+}
+impl Drop for CaptureState {
+    fn drop(&mut self) {
+        drop(self.data.take()); drop(self.index.take());
+        if let Some(paths) = self.paths.take() { for path in paths { let _ = std::fs::remove_file(path); } }
+    }
+}
+impl Drop for RulePages {
+    fn drop(&mut self) {
+        drop(self.files.get_mut().take());
+        for path in &self.paths { let _ = std::fs::remove_file(path); }
+    }
+}
