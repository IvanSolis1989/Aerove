+#[cfg(test)]
+mod owned_generation_tests {
+    use super::*;
+    use meow_common::transport_tasks::{TransportTaskContext, Work};
+    use std::sync::Mutex;
+    use tokio::task::{AbortHandle, JoinHandle};
+
+    #[derive(Default)]
+    struct JoinOwner {
+        tasks: Mutex<Vec<JoinHandle<()>>>,
+    }
+
+    impl TransportTaskContext for JoinOwner {
+        fn spawn(&self, work: Work) -> io::Result<AbortHandle> {
+            let task = tokio::spawn(work);
+            let abort = task.abort_handle();
+            self.tasks.lock().unwrap().push(task);
+            Ok(abort)
+        }
+    }
+
+    impl JoinOwner {
+        async fn close_joined(&self) {
+            let tasks = std::mem::take(&mut *self.tasks.lock().unwrap());
+            for task in &tasks {
+                task.abort();
+            }
+            for task in tasks {
+                let _ = task.await;
+            }
+        }
+    }
+
+    #[cfg(feature = "encrypted")]
+    struct RunOwnedRecursiveEchSource {
+        scope: TransportScope,
+        queries: Arc<std::sync::atomic::AtomicUsize>,
+    }
+
+    #[cfg(feature = "encrypted")]
+    impl meow_transport::tls::EchSource for RunOwnedRecursiveEchSource {
+        fn query<'a>(&'a self, name: &'a str) -> meow_transport::tls::EchQuery<'a> {
+            use std::sync::atomic::Ordering;
+
+            self.queries.fetch_add(1, Ordering::SeqCst);
+            let scope = self.scope.clone();
+            let name = name.to_owned();
+            Box::pin(async move {
+                run_owned_query(Some(scope), async move {
+                    meow_transport::tls::EchScope::resolve(name)
+                        .await
+                        .map_err(ClientError::Io)
+                })
+                .await
+                .map_err(|error| error.to_io())
+            })
+        }
+    }
+
+    /// Regression for the production HTTPS exchange spawn: recursive ECH
+    /// resolution must retain ancestry through run_owned_query's real task.
+    #[cfg(feature = "encrypted")]
+    #[tokio::test]
+    async fn ech_cycle_guard_survives_run_owned_query_spawn() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+
+        let owner = Arc::new(JoinOwner::default());
+        let scope = TransportScope::new(owner.clone());
+        let queries = Arc::new(AtomicUsize::new(0));
+        let ech = meow_transport::tls::EchScope::new(Arc::new(RunOwnedRecursiveEchSource {
+            scope,
+            queries: Arc::clone(&queries),
+        }));
+
+        let result = ech
+            .scope(async {
+                meow_transport::tls::EchScope::resolve("loop.example".to_owned()).await
+            })
+            .await;
+        let error = result.expect_err("recursive ECH DNS query must fail closed");
+        assert_eq!(error.kind(), io::ErrorKind::InvalidInput);
+        assert_eq!(error.to_string(), "echDnsCycle");
+        assert_eq!(queries.load(Ordering::SeqCst), 1, "cycle must stop before another source query");
+        assert_eq!(owner.tasks.lock().unwrap().len(), 1, "real exchange task must be owned");
+        owner.close_joined().await;
+        assert!(owner.tasks.lock().unwrap().is_empty(), "retirement must join and drain the task");
+    }
+
+    #[tokio::test]
+    async fn resolver_captures_generation_scope_when_constructed() {
+        let owner = Arc::new(JoinOwner::default());
+        let scope = TransportScope::new(owner);
+        let resolver = scope
+            .scope(async {
+                Resolver::new(
+                    vec![],
+                    vec![],
+                    DnsMode::Normal,
+                    DomainTrie::new(),
+                    true,
+                    true,
+                )
+            })
+            .await;
+        assert!(resolver.transport_scope.is_some());
+    }
+
+    #[tokio::test]
+    async fn upstream_exchange_stays_with_captured_generation() {
+        let old_owner = Arc::new(JoinOwner::default());
+        let next_owner = Arc::new(JoinOwner::default());
+        let old_scope = TransportScope::new(old_owner.clone());
+        let result = run_owned_query(Some(old_scope), async { Ok::<_, ClientError>(41_u8) })
+            .await
+            .unwrap();
+        assert_eq!(result, 41);
+        assert_eq!(old_owner.tasks.lock().unwrap().len(), 1);
+        assert!(next_owner.tasks.lock().unwrap().is_empty());
+        old_owner.close_joined().await;
+    }
+
+    #[tokio::test]
+    async fn retiring_generation_cancels_and_joins_pending_exchange() {
+        let owner = Arc::new(JoinOwner::default());
+        let scope = TransportScope::new(owner.clone());
+        let query = tokio::spawn(run_owned_query(
+            Some(scope),
+            std::future::pending::<Result<(), ClientError>>(),
+        ));
+        while owner.tasks.lock().unwrap().is_empty() {
+            tokio::task::yield_now().await;
+        }
+        owner.close_joined().await;
+        let error = query.await.unwrap().unwrap_err();
+        assert_eq!(error.to_io().kind(), io::ErrorKind::Interrupted);
+        assert!(owner.tasks.lock().unwrap().is_empty());
+    }
+}
