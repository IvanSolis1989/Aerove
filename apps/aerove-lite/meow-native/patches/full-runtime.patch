+    slot: ProviderSlot,
+    before: Vec<Arc<dyn Proxy>>,
+    after: Vec<Arc<dyn Proxy>>,
+}
+impl ProviderSlotProjection {
+    pub fn new(slots: Vec<(ProviderSlot, Vec<Arc<dyn Proxy>>)>) -> Self {
+        Self { slots: slots.into_iter().map(|(slot, after)| {
+            let before = slot.read().clone(); ProjectedProviderSlot { slot, before, after }
+        }).collect() }
+    }
+    /// Same slot identity as the real group owns; unrelated slots stay live.
+    pub fn members(&self, slot: &ProviderSlot) -> Vec<Arc<dyn Proxy>> {
+        self.slots.iter().find(|entry| Arc::ptr_eq(&entry.slot, slot))
+            .map_or_else(|| slot.read().clone(), |entry| entry.after.clone())
+    }
+    pub fn contains(&self, slot: &ProviderSlot) -> bool {
+        self.slots.iter().any(|entry| Arc::ptr_eq(&entry.slot, slot))
+    }
+    /// Pre-install only. Native also fences provider source/core epoch/intent
+    /// under its existing gate; ordered Arc equality is not an ABA epoch.
+    pub fn is_current(&self) -> bool {
+        self.slots.iter().all(|entry| {
+            let current = entry.slot.read();
+            current.len() == entry.before.len() && current.iter().zip(&entry.before).all(|(a,b)| Arc::ptr_eq(a,b))
+        })
+    }
+    pub fn is_installed(&self) -> bool {
+        self.slots.iter().all(|entry| {
+            let current = entry.slot.read();
+            current.len() == entry.after.len() && current.iter().zip(&entry.after).all(|(a,b)| Arc::ptr_eq(a,b))
+        })
+    }
