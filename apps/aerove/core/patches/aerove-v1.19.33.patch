+
+// RuleProvidersSnapshot is ProvidersSnapshot for rule providers.
+func RuleProvidersSnapshot() map[string]P.RuleProvider {
+	configMux.RLock()
+	defer configMux.RUnlock()
+	return ruleProviders
+}
