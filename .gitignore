app.*.symbols

# Obfuscation related
app.*.map.json

# Claude Code - ignore user-specific settings only
.claude/settings.local.json
.claude/worktrees/

# Disposable local evidence is never part of maintained documentation.
/scratch/
/.local/
/docs/.generated/
/docs/.drafts/


